# Stripe — get these from dashboard.stripe.com → Developers → API keys
STRIPE_SECRET_KEY=sk_live_...
FOUNDERS_PRICE_CENTS=4900   # $49.00 — change to whatever your founders price is

# Cloudflare Turnstile — dash.cloudflare.com → Turnstile → add site → Widget
# mode "Managed". The site key is public (ships to the browser on /reading);
# the matching secret key is NOT set here — it lives on the Cloud Functions
# side as the TURNSTILE_SECRET_KEY secret (`firebase functions:secrets:set`),
# since verification happens in generateLeadReading, not on this site.
# If PUBLIC_TURNSTILE_SITE_KEY is unset, the /reading page simply omits the
# widget rather than breaking.
PUBLIC_TURNSTILE_SITE_KEY=0x...
