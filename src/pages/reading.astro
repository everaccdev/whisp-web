---
export const prerender = false;

import MinimalLayout from '../layouts/MinimalLayout.astro';

// Cloudflare Turnstile site key is public by design (the secret half stays
// server-side in the generateLeadReading Cloud Function). If it isn't set,
// the widget is simply omitted rather than breaking the page — the Cloud
// Function only enforces verification when its own secret is configured,
// so the two stay in sync.
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY as string | undefined;
---

<MinimalLayout
  title="Get a Free Reading · Whisp"
  description="Tell Whisp what you've been noticing — a sign, a dream, or nothing at all — and get a short, honest reading in your inbox."
  ogUrl="https://getwhisp.app/reading"
>

<section class="reading-page">

  <div class="hero">
    <div class="hero-bg"></div>
    <div class="hero-wordmark">✦ whisp</div>
    <div class="hero-content">
      <p class="eyebrow">FREE READING</p>
      <h1 class="headline">
        What has life<br/><em>been showing you?</em>
      </h1>
      <p class="sub">
        Share a sign, a dream, or what's going on — or nothing at all — and get a short,
        honest reading sent to your inbox. No account needed.
      </p>
    </div>
  </div>

  <div class="form-wrap">
    <div class="form-card">
      <form id="reading-form">
        <div class="field-row">
          <div class="field">
            <label for="name-input">Your name</label>
            <input type="text" id="name-input" name="name" placeholder="Alex" autocomplete="name" required maxlength="80" />
          </div>
          <div class="field">
            <label for="email-input">Your email</label>
            <input type="email" id="email-input" name="email" placeholder="you@example.com" autocomplete="email" required maxlength="200" />
          </div>
        </div>

        <button type="button" id="toggle-more" class="toggle-more">
          <span id="toggle-more-label">+ Add a sign, dream, or what's going on (optional)</span>
        </button>

        <div class="more-fields" id="more-fields" hidden>
          <div class="field">
            <label for="sign-input">A sign or symbol you keep noticing</label>
            <input type="text" id="sign-input" name="sign" placeholder="e.g. 11:11, a cardinal, a certain song" maxlength="200" />
          </div>
          <div class="field">
            <label for="dream-input">A dream you've had recently</label>
            <textarea id="dream-input" name="dream" rows="3" placeholder="Whatever you remember of it..." maxlength="1000"></textarea>
          </div>
          <div class="field">
            <label for="situation-input">What's going on in your life right now</label>
            <textarea id="situation-input" name="situation" rows="3" placeholder="Optional, but it helps Whisp read more specifically" maxlength="1000"></textarea>
          </div>
        </div>

        {turnstileSiteKey && (
          <div class="cf-turnstile" data-sitekey={turnstileSiteKey} data-theme="dark"></div>
        )}

        <button type="submit" id="submit-btn">
          <span id="submit-text">Get My Reading ✦</span>
          <span id="submit-loading" style="display:none;">Reading the signs…</span>
        </button>

        <p id="form-error" class="form-error" hidden></p>

        <p class="fine">
          We'll email you the reading and occasional notes from Whisp. Unsubscribe any time —
          see our <a href="/privacy">privacy policy</a>.
        </p>
      </form>
    </div>
  </div>

  <p class="footer-mark">getwhisp.app</p>

</section>

{turnstileSiteKey && (
  <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
)}

<script>
  const toggleBtn   = document.getElementById('toggle-more') as HTMLButtonElement;
  const toggleLabel = document.getElementById('toggle-more-label') as HTMLSpanElement;
  const moreFields  = document.getElementById('more-fields') as HTMLDivElement;

  toggleBtn.addEventListener('click', () => {
    const isHidden = moreFields.hasAttribute('hidden');
    if (isHidden) {
      moreFields.removeAttribute('hidden');
      toggleLabel.textContent = '– Hide extra details';
    } else {
      moreFields.setAttribute('hidden', '');
      toggleLabel.textContent = "+ Add a sign, dream, or what's going on (optional)";
    }
  });

  const form        = document.getElementById('reading-form') as HTMLFormElement;
  const submitBtn   = document.getElementById('submit-btn')    as HTMLButtonElement;
  const submitText  = document.getElementById('submit-text')   as HTMLSpanElement;
  const submitSpin  = document.getElementById('submit-loading') as HTMLSpanElement;
  const errorEl     = document.getElementById('form-error')    as HTMLParagraphElement;

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    errorEl.hidden = true;

    const nameInput  = document.getElementById('name-input')  as HTMLInputElement;
    const emailInput = document.getElementById('email-input') as HTMLInputElement;
    const signInput      = document.getElementById('sign-input')      as HTMLInputElement;
    const dreamInput     = document.getElementById('dream-input')     as HTMLTextAreaElement;
    const situationInput = document.getElementById('situation-input') as HTMLTextAreaElement;

    const turnstileField = form.querySelector('[name="cf-turnstile-response"]') as HTMLInputElement | null;

    let utm = null;
    try { utm = JSON.parse(localStorage.getItem('whisp_utm') || 'null'); } catch (e) {}

    submitBtn.disabled = true;
    submitText.style.display = 'none';
    submitSpin.style.display = 'inline';

    try {
      const hadContext = !!(signInput.value.trim() || dreamInput.value.trim() || situationInput.value.trim());
      (window as any).posthog?.capture('website_reading_requested', { had_context: hadContext });

      const res = await fetch('/api/lead-reading', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          name: nameInput.value.trim(),
          email: emailInput.value.trim(),
          sign: signInput.value.trim(),
          dream: dreamInput.value.trim(),
          situation: situationInput.value.trim(),
          turnstileToken: turnstileField?.value || '',
          utm,
        }),
      });
      const data = await res.json();

      if (res.ok && data.readingId) {
        window.location.href = `/r/${data.readingId}`;
        return;
      }

      throw new Error(data.error || 'Something went wrong. Please try again.');
    } catch (err: any) {
      errorEl.textContent = err.message;
      errorEl.hidden = false;
      submitBtn.disabled = false;
      submitText.style.display = 'inline';
      submitSpin.style.display = 'none';
    }
  });
</script>

<style>
  .reading-page {
    min-height: 100vh;
    background: linear-gradient(180deg, #07041a 0%, #0e0830 40%, #050212 100%);
    color: #faf8f3;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  /* ── Hero ──────────────────────────────────────────────────────────────── */
  .hero {
    position: relative;
    width: 100%;
    padding: 72px 24px 40px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    overflow: hidden;
  }
  .hero-bg {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse at 50% 0%, rgba(149,117,205,0.25) 0%, transparent 60%),
      radial-gradient(ellipse at 30% 80%, rgba(240,192,64,0.08) 0%, transparent 55%);
  }
  .hero-wordmark {
    font-family: 'Cormorant Garamond', serif;
    font-style: italic;
    font-weight: 300;
    font-size: 22px;
    color: rgba(255,248,235,0.6);
    letter-spacing: 1px;
    margin-bottom: 32px;
    position: relative;
    z-index: 1;
  }
  .hero-content {
    position: relative;
    z-index: 1;
    max-width: 560px;
  }
  .eyebrow {
    font-family: 'Raleway', sans-serif;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 3px;
    color: #9575CD;
    margin: 0 0 20px;
  }
  .headline {
    font-family: 'Cormorant Garamond', serif;
    font-weight: 300;
    font-size: clamp(30px, 7.5vw, 48px);
    line-height: 1.15;
    color: #faf8f3;
    margin: 0 0 20px;
  }
  .headline em { font-style: italic; color: #F0C040; }
  .sub {
    font-family: 'Raleway', sans-serif;
    font-size: 16px;
    line-height: 1.7;
    color: rgba(255,255,255,0.68);
    max-width: 460px;
    margin: 0 auto;
  }

  /* ── Form ──────────────────────────────────────────────────────────────── */
  .form-wrap {
    width: 100%;
    max-width: 520px;
    padding: 12px 24px 40px;
  }
  .form-card {
    background: rgba(149,117,205,0.08);
    border: 0.5px solid rgba(149,117,205,0.3);
    border-radius: 20px;
    padding: 32px 28px;
  }

  .field-row {
    display: flex;
    gap: 12px;
    margin-bottom: 6px;
  }
  .field { flex: 1; display: flex; flex-direction: column; gap: 6px; margin-bottom: 16px; }
  .field label {
    font-family: 'Raleway', sans-serif;
    font-size: 12px;
    color: rgba(255,255,255,0.55);
  }
  .field input, .field textarea {
    padding: 13px 14px;
    border-radius: 10px;
    border: 0.5px solid rgba(149,117,205,0.3);
    background: rgba(255,255,255,0.04);
    color: #faf8f3;
    font-family: 'Raleway', sans-serif;
    font-size: 14px;
    resize: vertical;
  }
  .field input::placeholder, .field textarea::placeholder { color: rgba(255,255,255,0.3); }

  .toggle-more {
    display: block;
    width: 100%;
    text-align: left;
    background: none;
    border: none;
    padding: 4px 0 20px;
    font-family: 'Raleway', sans-serif;
    font-size: 12.5px;
    color: #9575CD;
    cursor: pointer;
  }
  .more-fields {
    display: flex;
    flex-direction: column;
    padding-top: 4px;
  }

  .cf-turnstile { margin-bottom: 16px; }

  #submit-btn {
    width: 100%;
    background: #F0C040;
    color: #0a0618;
    font-family: 'Raleway', sans-serif;
    font-weight: 700;
    font-size: 14px;
    letter-spacing: 0.3px;
    padding: 15px;
    border: none;
    border-radius: 10px;
    cursor: pointer;
  }
  #submit-btn:disabled { opacity: 0.6; cursor: default; }

  .form-error {
    font-family: 'Raleway', sans-serif;
    font-size: 12.5px;
    color: #ff8a8a;
    margin: 14px 0 0;
    text-align: center;
  }

  .fine {
    font-family: 'Raleway', sans-serif;
    font-size: 11.5px;
    color: rgba(255,255,255,0.45);
    line-height: 1.6;
    margin-top: 16px;
    text-align: center;
  }
  .fine a { color: rgba(255,255,255,0.6); }

  .footer-mark {
    font-family: 'Raleway', sans-serif;
    font-size: 10px;
    letter-spacing: 1px;
    color: rgba(255,255,255,0.25);
    padding-bottom: 40px;
  }

  @media (max-width: 480px) {
    .field-row { flex-direction: column; gap: 0; }
  }
</style>

</MinimalLayout>
