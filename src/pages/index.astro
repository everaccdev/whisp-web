    gap: 14px;
    width: 100%;
    padding: 10px 20px;
    border-radius: 6px;
    background: rgba(255,255,255,0.02);
  }
  .demo-beat-day {
    flex-shrink: 0;
    width: 56px;
    font-family: var(--font-display);
    font-size: 0.65rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--gold-dim);
  }
  .demo-beat-sign {
    font-family: var(--font-heading);
    font-size: 1.05rem;
    color: var(--cream);
  }
  .demo-beat-arrow {
    color: var(--gold-dim);
    font-size: 0.85rem;
    opacity: 0.5;
    line-height: 1;
    padding: 2px 0;
  }
  .demo-result {
    max-width: 480px;
    margin: 28px auto 0;
    padding: 22px 26px;
    border: 1px solid rgba(201,168,76,0.35);
    border-radius: 8px;
    background: rgba(201,168,76,0.06);
    text-align: center;
  }
  .demo-result-label {
    display: block;
    font-family: var(--font-display);
    font-size: 0.65rem;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 10px;
  }
  .demo-result-text {
    font-family: var(--font-heading);
    font-size: 1.2rem;
    color: var(--cream);
    line-height: 1.5;
  }
  .demo-caveat {
    max-width: 480px;
    margin: 20px auto 0;
    text-align: center;
    font-size: 0.75rem;
    line-height: 1.6;
    color: var(--cream-dim);
    opacity: 0.65;
  }
  /* ── WHAT PEOPLE WRITE ──
     Atmospheric treatment (same bg + heavy-scrim pattern as .philosophy)
     because this is an emotional beat, not an evidence one. Kept quieter
     than the hero: the scrim is deliberately heavier so the three stories
     carry the section rather than the artwork. */
  .stories {
    position: relative;
    padding: var(--section-pad) 0;
    overflow: hidden;
  }
  .stories-bg {
    position: absolute;
    inset: 0;
    background-image: url('/stories-bg.jpg');
    background-size: cover;
    background-position: center 55%;
    z-index: 0;
  }
  .stories-overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      linear-gradient(to bottom,
        rgba(8,12,24,0.94) 0%,
        rgba(8,12,24,0.80) 35%,
        rgba(8,12,24,0.80) 65%,
        rgba(8,12,24,0.94) 100%
      );
  }
  .stories .container {
    position: relative;
    z-index: 2;
  }
  .stories .section-header {
    max-width: 640px;
    margin: 0 auto 44px;
    text-align: center;
  }
  .stories .section-title { margin-top: 14px; }
  .stories .section-sub { margin-top: 16px; }
  .stories-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    max-width: 1020px;
    margin: 0 auto;
    align-items: stretch;
  }
  .story {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 30px 26px 26px;
    border: 1px solid var(--navy-border);
    border-radius: 10px;
    background: rgba(8,12,24,0.55);
    backdrop-filter: blur(2px);
  }
  .story-mark {
    display: block;
    color: var(--gold);
    opacity: 0.5;
    font-size: 0.85rem;
    line-height: 1;
    margin-bottom: 16px;
  }
  .story-label {
    font-family: var(--font-display);
    font-size: 0.64rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--gold-dim);
    margin-bottom: 14px;
    line-height: 1.5;
  }
  .story-text {
    font-family: var(--font-heading);
    font-size: 1.06rem;
    line-height: 1.7;
    color: var(--cream);
    margin-bottom: 18px;
  }
  /* The turn — pushed to the card's baseline so all three align regardless
     of scenario length, and set apart by a hairline so the emotional beat
     reads as a separate movement rather than a fourth sentence. */
  .story-turn {
    margin-top: auto;
    padding-top: 16px;
    border-top: 1px solid var(--navy-border);
    font-family: var(--font-heading);
    font-style: italic;
    font-size: 1rem;
    line-height: 1.65;
    color: var(--gold-light);
    opacity: 0.88;
  }
  /* Reserved for when permissioned attribution lands — drops straight in
     under any .story-turn without restructuring the section. */
  .story-attrib {
    display: block;
    margin-top: 12px;
    font-family: var(--font-display);
    font-size: 0.66rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--gold-dim);
  }
  .stories-close {
    max-width: 560px;
    margin: 44px auto 0;
    padding-top: 28px;
    border-top: 1px solid var(--navy-border);
    text-align: center;
    font-family: var(--font-heading);
    font-style: italic;
    font-size: 1.02rem;
    line-height: 1.7;
    color: var(--cream-dim);
  }
  @media (max-width: 900px) {
    .stories-grid { grid-template-columns: 1fr; max-width: 560px; gap: 16px; }
    .story { padding: 26px 24px 24px; }
  }
  @media (max-width: 600px) {
    .story-text { font-size: 1.02rem; }
    .story-turn { font-size: 0.97rem; }
    .stories-close { font-size: 0.96rem; margin-top: 36px; }
  }

  @media (max-width: 600px) {
    .demo-beat { padding: 9px 14px; gap: 10px; }
    .demo-beat-day { width: 46px; font-size: 0.6rem; }
    .demo-beat-sign { font-size: 0.95rem; }
    .demo-result { padding: 18px 20px; }
    .demo-result-text { font-size: 1.05rem; }
  }

  /* ── SIGNS COME IN EVERY FORM ── */
  .signs-variety {
    padding: clamp(60px, 8vw, 100px) 0;
  }
  .signs-variety .section-header {
    max-width: 620px;
    margin: 0 auto 40px;
    text-align: center;
  }
  .signs-variety .section-title { margin-top: 14px; }
  .signs-variety .section-sub { margin-top: 16px; }
  .signs-visual {
    max-width: 820px;
    margin: 0 auto;
    border-radius: 14px;
    overflow: hidden;
    border: 1px solid var(--navy-border);
    box-shadow: 0 24px 70px rgba(0,0,0,0.4);
  }
  .signs-visual img {
    display: block;
    width: 100%;
    height: auto;
  }

  /* ── CAROUSEL CHROME (shared: App Showcase's #appshot-scroll) ──
     Was written under "App Slides" originally and shared by both
     carousels via CSS not caring about source order — the App Slides
     section itself was cut (Emotional Narrative Pass, Phase 6: it
     restated Features almost 1:1 in a second visual format immediately
     next to this other, more credible screenshot carousel), but these
     nav/dot/spacer rules stayed since Showcase still uses them. */
  .slides-spacer { flex: 0 0 clamp(24px,6vw,80px); }

  .slides-nav {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    margin-top: 28px;
    padding: 0 clamp(24px,5vw,64px);
  }
  .sc-btn {
    background: rgba(255,255,255,0.07);
    border: 1px solid rgba(201,168,76,0.2);
    color: var(--cream-dim);
    width: 34px;
    height: 34px;
    border-radius: 50%;
    cursor: pointer;
    font-size: 0.85rem;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s;
  }
  .sc-btn:hover { border-color: var(--gold-dim); color: var(--gold-light); }
  .sc-dots { display: flex; gap: 8px; align-items: center; }
  .sc-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: rgba(200,196,184,0.22);
    border: none;
    cursor: pointer;
    transition: all 0.25s;
    padding: 0;
  }
  .sc-dot.active { background: var(--gold); transform: scale(1.4); }

  .section-header {
    text-align: center;
    margin-bottom: 64px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
  }
  .section-title {
    font-family: var(--font-heading);
    font-size: clamp(2rem, 4vw, 3rem);
    color: var(--cream);
    font-weight: 300;
  }
  .section-sub {
    max-width: 520px;
    font-family: var(--font-heading);
    font-size: 1.05rem;
    color: var(--cream-dim);
    text-align: center;
    line-height: 1.7;
  }

  /* ── HOW IT WORKS ── */
  .how-it-works { padding: var(--section-pad) 0; }
  .steps {
    display: flex;
    flex-direction: column;
    gap: 0;
    max-width: 700px;
    margin: 0 auto;
  }
  .step {
    display: grid;
    grid-template-columns: 80px 1fr;
    gap: 32px;
    padding: 40px 0;
    border-bottom: 1px solid rgba(30, 45, 80, 0.4);
  }
  .step:last-child { border-bottom: none; }
  .step-number {
    font-family: var(--font-display);
    font-size: 0.7rem;
    letter-spacing: 0.2em;
    color: var(--gold);
    opacity: 0.5;
    padding-top: 6px;
  }
  .step-content h3 {
    font-family: var(--font-heading);
    font-size: 1.5rem;
    font-weight: 500;
    margin-bottom: 12px;
    color: var(--cream);
  }
  .step-content p {
    font-size: 0.95rem;
    color: var(--cream-dim);
    line-height: 1.8;
  }
  .step-connector {
    text-align: center;
    color: rgba(201, 168, 76, 0.2);
    font-size: 0.8rem;
    letter-spacing: 6px;
    padding: 4px 0;
  }

  /* ── PHILOSOPHY ── */
  .philosophy {
    position: relative;
    padding: var(--section-pad) 0;
    overflow: hidden;
  }
  .philosophy-bg {
    position: absolute;
    inset: 0;
    background-image: url('/philosophy-bg.jpg');
    background-size: cover;
    background-position: center 40%;
    z-index: 0;
  }
  .philosophy-overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      linear-gradient(to bottom,
        rgba(8,12,24,0.88) 0%,
        rgba(8,12,24,0.65) 30%,
        rgba(8,12,24,0.65) 70%,
        rgba(8,12,24,0.88) 100%
      );
  }
  .philosophy .container {
    position: relative;
    z-index: 2;
  }
  .philosophy-inner {
    max-width: 720px;
    margin: 0 auto;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 28px;
  }
  .philosophy-glyph {
    font-size: 1.5rem;
    color: var(--gold);
    opacity: 0.4;
  }
  .philosophy-quote {
    font-family: var(--font-heading);
    font-size: clamp(1.5rem, 3vw, 2.2rem);
    font-style: italic;
    font-weight: 300;
    color: var(--cream);
    line-height: 1.5;
  }
  .philosophy-body {
    font-size: 1rem;
    color: var(--cream-dim);
    line-height: 1.9;
    font-family: var(--font-heading);
    max-width: 600px;
  }

  /* ── PRICING ── */
  .pricing { padding: var(--section-pad) 0; }
  /* Live founder counter — same visual language as founders.astro's
     .counter-pill (not copy-pasted 1:1; uses this page's own --gold /
     --gold-light tokens instead of hardcoded hex, per "don't redesign the
     visual system, do reuse it"). */
  .counter-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 16px;
    border-radius: 999px;
    background: rgba(201,168,76,0.08);
    border: 0.5px solid rgba(201,168,76,0.3);
    font-family: var(--font-body);
    font-size: 0.78rem;
    color: rgba(255,255,255,0.75);
    margin-top: 18px;
  }
  .counter-pill strong { color: var(--gold-light); font-weight: 700; }
  .counter-pill[data-state="capped"] {
    background: rgba(255,255,255,0.05);
    border-color: rgba(255,255,255,0.15);
    color: rgba(255,255,255,0.5);
  }
  .pricing-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    max-width: 800px;
    margin: 0 auto;
  }
  .pricing-card {
    background: rgba(15, 24, 48, 0.6);
    border: 1px solid var(--navy-border);
    border-radius: 8px;
    padding: 40px;
    display: flex;
    flex-direction: column;
    gap: 20px;
    position: relative;
  }
  .pricing-card--featured {
    border-color: rgba(201, 168, 76, 0.35);
    background: rgba(22, 32, 64, 0.8);
    box-shadow: 0 0 60px rgba(201, 168, 76, 0.06);
  }
  .pricing-badge {
    position: absolute;
    top: -12px;
    left: 50%;
    transform: translateX(-50%);
    background: var(--gold);
    color: var(--navy);
    font-family: var(--font-display);
    font-size: 0.6rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    padding: 4px 14px;
    border-radius: 2px;
    white-space: nowrap;
  }
  .pricing-tier {
    font-family: var(--font-display);
    font-size: 0.7rem;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--gold);
  }
  .pricing-price {
    display: flex;
    align-items: baseline;
    gap: 8px;
  }
  .price-amount {
    font-family: var(--font-heading);
    font-size: 2.8rem;
    font-weight: 300;
    color: var(--cream);
    line-height: 1;
  }
  .price-period {
    font-size: 0.8rem;
    color: var(--cream-dim);
  }
  .pricing-note {
    font-size: 0.8rem;
    color: var(--gold);
    opacity: 0.7;
    font-style: italic;
    font-family: var(--font-heading);
    margin-top: -8px;
  }
  .pricing-features {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
    flex: 1;
  }
  .pricing-features li {
    font-size: 0.875rem;
    color: var(--cream-dim);
  }

  /* ── FAQ ── */
  .faq {
    padding: var(--section-pad) 0;
    border-top: 1px solid var(--navy-border);
  }
  .faq-list {
    max-width: 720px;
    margin: 0 auto 48px;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .faq-item {
    border: 1px solid var(--navy-border);
    border-radius: 8px;
    overflow: hidden;
    background: rgba(15, 24, 48, 0.4);
    transition: border-color 0.2s;
  }
  .faq-item[open] {
    border-color: rgba(201, 168, 76, 0.3);
  }
  .faq-q {
    list-style: none;
    padding: 20px 24px;
    font-family: var(--font-heading);
    font-size: 1.05rem;
    font-weight: 400;
    color: var(--cream);
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    user-select: none;
    transition: color 0.2s;
  }
  .faq-q::-webkit-details-marker { display: none; }
  .faq-q::after {
    content: '+';
    font-family: var(--font-body);
    font-size: 1.2rem;
    font-weight: 300;
    color: var(--gold);
    opacity: 0.6;
    flex-shrink: 0;
    transition: transform 0.2s, opacity 0.2s;
  }
  .faq-item[open] .faq-q::after {
    transform: rotate(45deg);
    opacity: 1;
  }
  .faq-item[open] .faq-q { color: var(--cream); }
  .faq-a {
    padding: 0 24px 20px;
    font-family: var(--font-heading);
    font-size: 0.95rem;
    color: var(--cream-dim);
    line-height: 1.8;
    border-top: 1px solid var(--navy-border);
    margin-top: 0;
  }
  .faq-contact {
    text-align: center;
    font-family: var(--font-body);
    font-size: 0.875rem;
    color: var(--cream-dim);
    opacity: 0.6;
  }
  .faq-link {
    color: var(--gold-light);
    border-bottom: 1px solid rgba(201, 168, 76, 0.3);
    transition: border-color 0.2s;
    margin-left: 4px;
  }
  .faq-link:hover { border-color: var(--gold); }

  /* ── FINAL CTA ── */
  .final-cta {
    padding: var(--section-pad) 0;
  }
  .cta-inner {
    max-width: 600px;
    margin: 0 auto;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    padding: 64px 48px;
    border: 1px solid var(--navy-border);
    border-radius: 12px;
    background: rgba(15, 24, 48, 0.5);
  }
  .cta-glyph {
    font-size: 2rem;
    color: var(--gold);
    opacity: 0.4;
  }
  .cta-inner h2 {
    font-family: var(--font-heading);
    font-size: clamp(1.8rem, 3vw, 2.5rem);
    font-weight: 300;
    color: var(--cream);
  }
  .cta-inner p {
    font-family: var(--font-heading);
    font-size: 1.1rem;
    font-style: italic;
    color: var(--cream-dim);
    margin-bottom: 8px;
  }
  .cta-note {
    font-family: var(--font-display);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    color: rgba(200,196,184,0.35);
  }

  /* ── RESPONSIVE ── */
  @media (max-width: 900px) {
    .feature-card--large { grid-column: span 2; }
  }
  @media (max-width: 640px) {
    .feature-card--large { grid-column: span 1; }
    .pricing-grid { grid-template-columns: 1fr; }
    .step { grid-template-columns: 48px 1fr; gap: 20px; }
    .cta-inner { padding: 40px 24px; }
  }

  /* ── APP SHOWCASE ── */
  .showcase {
    padding: var(--section-pad) 0 0;
    overflow: hidden;
  }
  .appshot-scroll {
    display: flex;
    gap: 18px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    margin-top: 56px;
    padding: 0 clamp(24px, 6vw, 80px);
    -webkit-overflow-scrolling: touch;
  }
  .appshot-scroll::-webkit-scrollbar { display: none; }
  .appshot-card {
    flex: 0 0 420px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    scroll-snap-align: start;
  }
  .appshot-img {
    width: 100%;
    aspect-ratio: 1672 / 941;
    object-fit: cover;
    display: block;
    border-radius: 14px;
    background: #06080f;
    box-shadow: 0 24px 60px rgba(0,0,0,0.5);
    cursor: zoom-in;
    transition: transform 0.25s ease;
  }
  .appshot-img:hover { transform: scale(1.015); }
  .appshot-caption {
    text-align: center;
    font-family: var(--font-heading);
    font-size: 0.9rem;
    font-style: italic;
    color: var(--cream-dim);
    padding: 0 8px;
  }

  /* Click-to-enlarge overlay for the showcase carousel */
  .appshot-lightbox {
    position: fixed;
    inset: 0;
    z-index: 200;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(20px, 6vw, 64px);
    background: rgba(6,8,15,0.92);
    backdrop-filter: blur(6px);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.25s ease;
  }
  .appshot-lightbox.open { opacity: 1; visibility: visible; }
  .appshot-lightbox-img {
    max-width: 100%;
    max-height: 100%;
    border-radius: 14px;
    box-shadow: 0 30px 80px rgba(0,0,0,0.6);
    cursor: zoom-out;
  }
  .appshot-lightbox-close {
    position: absolute;
    top: clamp(16px, 4vw, 32px);
    right: clamp(16px, 4vw, 32px);
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: rgba(255,255,255,0.08);
    border: 1px solid rgba(201,168,76,0.25);
    color: var(--cream-dim);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.2s;
  }
  .appshot-lightbox-close:hover { border-color: var(--gold-dim); color: var(--gold-light); }

  /* ── WHAT'S NEW ── */
  .whats-new {
    padding: var(--section-pad) 0;
  }
  .wn-header {
    text-align: center;
    margin-bottom: 56px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
  }
  .wn-badge {
    font-family: var(--font-display);
    font-size: 0.6rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    padding: 5px 14px;
    border-radius: 2px;
    background: rgba(201,168,76,0.1);
    color: var(--gold);
    border: 1px solid rgba(201,168,76,0.28);
  }
  .wn-period {
    margin-bottom: 48px;
  }
  .wn-period:last-child {
    margin-bottom: 0;
  }
  .wn-period-label {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 20px;
  }
  .wn-period-date {
    font-family: var(--font-display);
    font-size: 0.68rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--gold);
    opacity: 0.85;
    white-space: nowrap;
  }
  .wn-period-line {
    flex: 1;
    height: 1px;
    background: linear-gradient(to right, rgba(201,168,76,0.25), transparent);
  }
  .wn-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }
  .wn-card {
    background: rgba(12,20,42,0.65);
    border: 1px solid var(--navy-border);
    border-radius: 8px;
    padding: 26px 22px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    transition: border-color 0.28s, transform 0.28s;
    position: relative;
  }
  .wn-card:hover {
    border-color: rgba(201,168,76,0.22);
    transform: translateY(-2px);
  }
  .wn-icon {
    font-size: 1.35rem;
    color: var(--gold);
    opacity: 0.55;
    line-height: 1;
  }
  .wn-label {
    font-family: var(--font-display);
    font-size: 0.54rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--cream-dim);
    opacity: 0.6;
  }
  .wn-label--sacred {
    color: rgba(180,150,220,0.9);
    opacity: 1;
  }
  .wn-label--premium {
    color: var(--gold);
    opacity: 0.75;
  }
  .wn-title {
    font-family: var(--font-heading);
    font-size: 1.15rem;
    font-weight: 500;
    color: var(--cream);
    line-height: 1.2;
  }
  .wn-desc {
    font-size: 0.82rem;
    color: var(--cream-dim);
    line-height: 1.68;
  }

  /* Showcase + What's New responsive */
  @media (max-width: 1100px) {
    .wn-grid { grid-template-columns: repeat(3, 1fr); }
  }
  @media (max-width: 900px) {
    .wn-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 640px) {
    .wn-grid { grid-template-columns: 1fr 1fr; }
    .appshot-card { flex: 0 0 280px; }
  }
  @media (max-width: 480px) {
    .wn-grid { grid-template-columns: 1fr; }
  }

  /* ══════════ NARRATIVE REWORK — new sections ══════════ */

  /* ── RECOGNITION ── */
  .validation-title {
    font-family: var(--font-heading);
    font-size: clamp(1.6rem, 3.6vw, 2.5rem);
    font-weight: 300;
    line-height: 1.35;
    color: var(--cream);
    margin-bottom: 48px;
  }
  .validation-title em { font-style: italic; color: var(--gold-light); }
  .validation-line-beat {
    display: inline-block;
    margin-top: 4px;
    color: var(--cream);
  }

  /* ── MEMORY ──
     "Whisp doesn't." carries the section. Nothing explanatory follows it. */
  .tension-step {
    font-family: var(--font-heading);
    font-size: clamp(1.35rem, 3vw, 2rem);
    font-weight: 300;
    line-height: 1.45;
    color: var(--cream);
    margin-bottom: 10px;
  }
  .tension-aside {
    font-size: 0.92rem;
    color: var(--cream-dim);
    opacity: 0.7;
    margin: 22px 0 46px;
  }
  .tension-resolve {
    font-family: var(--font-heading);
    font-size: clamp(2.1rem, 5.5vw, 3.6rem);
    font-style: italic;
    font-weight: 300;
    line-height: 1.2;
    color: var(--gold-light);
  }

  /* ── DEPTH ── */
  .depth {
    padding: var(--section-pad) 0;
    background: linear-gradient(180deg, var(--navy-mid) 0%, var(--navy) 100%);
    border-top: 1px solid var(--navy-border);
    border-bottom: 1px solid var(--navy-border);
  }
  .depth .section-header { max-width: 660px; margin: 0 auto 64px; text-align: center; }
  .depth-open {
    font-family: var(--font-heading);
    font-size: clamp(1.7rem, 4vw, 2.7rem);
    font-weight: 300;
    line-height: 1.3;
    color: var(--cream);
  }
  .depth-open em { font-style: italic; color: var(--gold-light); }
  .depth-sub { margin-top: 18px; font-size: 1rem; line-height: 1.75; color: var(--cream-dim); }

  .depth-composition {
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
    max-width: 940px;
    margin: 0 auto;
  }
  .depth-moment {
    text-align: center;
    padding: 34px 28px;
    border: 1px solid rgba(201,168,76,0.3);
    border-radius: 12px;
    background: rgba(201,168,76,0.05);
    max-width: 440px;
    margin: 0 auto;
    position: relative;
  }
  .depth-moment::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: -40px;
    width: 1px;
    height: 40px;
    background: linear-gradient(to bottom, rgba(201,168,76,0.45), transparent);
  }
  .depth-moment-label {
    display: block;
    font-family: var(--font-display);
    font-size: 0.6rem;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    color: var(--gold-dim);
    margin-bottom: 14px;
  }
  .depth-moment-text {
    font-family: var(--font-heading);
    font-size: clamp(1.25rem, 2.6vw, 1.7rem);
    font-weight: 300;
    line-height: 1.4;
    color: var(--cream);
  }
  .depth-moment-text em { font-style: italic; color: var(--gold-light); }

  .depth-context {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 30px 44px;
  }
  .depth-ctx { position: relative; padding-left: 20px; }
  .depth-ctx::before {
    content: '';
    position: absolute;
    left: 0; top: 9px;
    width: 4px; height: 4px;
    border-radius: 50%;
    background: var(--gold-dim);
  }
  .depth-ctx-label {
    font-family: var(--font-display);
    font-size: 0.62rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 9px;
  }
  .depth-ctx-text { font-size: 0.95rem; line-height: 1.7; color: var(--cream-dim); }

  .depth-land { margin: 72px auto 0; max-width: 620px; text-align: center; }
  .depth-land-text {
    font-family: var(--font-heading);
    font-size: clamp(1.5rem, 3.6vw, 2.35rem);
    font-weight: 300;
    line-height: 1.45;
    color: var(--cream);
  }
  .depth-land-text em { font-style: italic; color: var(--gold-light); }

  /* ── STORIES additions ── */
  .story-turn--solo {
    font-size: 1.5rem;
    font-style: normal;
    color: var(--gold-light);
    padding-top: 18px;
  }
  .story-coda {
    margin-top: 12px;
    font-size: 0.95rem;
    line-height: 1.65;
    color: var(--cream-dim);
  }
  .stories-close-block { margin: 56px auto 0; max-width: 560px; text-align: center; }
  .stories-question {
    font-family: var(--font-heading);
    font-size: clamp(1.5rem, 3.4vw, 2.2rem);
    font-weight: 300;
    line-height: 1.35;
    color: var(--cream);
    margin-bottom: 26px;
  }
  .stories-question em { font-style: italic; color: var(--gold-light); }
  .stories-cta {
    display: inline-block;
    font-family: var(--font-display);
    font-size: 0.78rem;
    letter-spacing: 0.14em;
    color: var(--gold);
    border-bottom: 1px solid rgba(201,168,76,0.4);
    padding-bottom: 3px;
  }
  .stories-cta:hover { color: var(--gold-light); border-bottom-color: var(--gold-light); }
  .stories-note {
    max-width: 520px;
    margin: 44px auto 0;
    text-align: center;
    font-size: 0.73rem;
    line-height: 1.65;
    color: var(--cream-dim);
    opacity: 0.55;
  }

  /* ── EXPANSION ── */
  .expansion {
    padding: var(--section-pad) 0;
    background: var(--navy);
    text-align: center;
  }
  .expansion-title {
    font-family: var(--font-heading);
    font-size: clamp(1.9rem, 4.6vw, 3rem);
    font-weight: 300;
    line-height: 1.25;
    color: var(--cream);
    margin-bottom: 54px;
  }
  .expansion-title em { font-style: italic; color: var(--gold-light); }
  .expansion-lines { max-width: 520px; margin: 0 auto; }
  .expansion-line {
    font-family: var(--font-heading);
    font-size: 1.12rem;
    line-height: 1.6;
    color: var(--cream-dim);
    padding: 11px 0;
  }
  .expansion-turn {
    margin-top: 54px;
    font-family: var(--font-heading);
    font-size: clamp(1.4rem, 3.4vw, 2.1rem);
    font-weight: 300;
    line-height: 1.4;
    color: var(--cream);
  }
  .expansion-turn em { font-style: italic; color: var(--gold-light); }

  /* ── PATTERN question ── */
  .demo-question {
    max-width: 520px;
    margin: 46px auto 0;
    text-align: center;
    font-family: var(--font-heading);
    font-size: clamp(1.4rem, 3.4vw, 2.1rem);
    font-weight: 300;
    line-height: 1.35;
    color: var(--cream);
  }
  .demo-question em { font-style: italic; color: var(--gold-light); }

  /* ── DIFFERENTIATOR ── */
  .differentiator {
    padding: var(--section-pad) 0;
    background: linear-gradient(180deg, var(--navy) 0%, var(--navy-mid) 100%);
    border-top: 1px solid var(--navy-border);
  }
  .diff-inner { max-width: 640px; margin: 0 auto; text-align: center; }
  .diff-open {
    font-family: var(--font-heading);
    font-size: clamp(1.7rem, 4vw, 2.6rem);
    font-weight: 300;
    line-height: 1.3;
    color: var(--cream-dim);
  }
  .diff-open em { font-style: italic; color: var(--cream); }
  .diff-pivot {
    margin-top: 30px;
    font-family: var(--font-heading);
    font-size: clamp(1.5rem, 3.6vw, 2.3rem);
    font-weight: 300;
    line-height: 1.35;
    color: var(--cream);
  }
  .diff-pivot em { font-style: italic; color: var(--gold-light); }
  .diff-list { list-style: none; margin: 40px auto 0; max-width: 560px; }
  .diff-list li {
    font-size: 1rem;
    line-height: 1.7;
    color: var(--cream-dim);
    padding: 10px 0;
  }
  .diff-answer {
    margin-top: 44px;
    font-family: var(--font-heading);
    font-size: clamp(2rem, 5vw, 3.2rem);
    font-style: italic;
    font-weight: 300;
    color: var(--gold-light);
  }
  .diff-close { margin-top: 72px; padding-top: 48px; border-top: 1px solid var(--navy-border); }
  .diff-close-title {
    font-family: var(--font-heading);
    font-size: clamp(1.4rem, 3.4vw, 2.1rem);
    font-weight: 300;
    line-height: 1.35;
    color: var(--cream);
  }
  .diff-close-title em { font-style: italic; color: var(--gold-light); }
  .diff-close-body { margin-top: 22px; font-size: 1rem; line-height: 1.9; color: var(--cream-dim); }

  /* ── ECOSYSTEM ── */
  .ecosystem {
    padding: var(--section-pad) 0;
    background: var(--navy-mid);
    border-top: 1px solid var(--navy-border);
  }
  .ecosystem .section-header { max-width: 640px; margin: 0 auto 60px; text-align: center; }
  .eco-map {
    display: grid;
    grid-template-columns: 1.6fr auto 1fr;
    gap: 34px;
    align-items: center;
    max-width: 1000px;
    margin: 0 auto;
  }
  .eco-inputs { display: grid; gap: 26px; }
  .eco-group {
    padding: 22px 24px;
    border: 1px solid var(--navy-border);
    border-radius: 10px;
    background: rgba(255,255,255,0.015);
  }
  .eco-group-title {
    font-family: var(--font-display);
    font-size: 0.62rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--gold-dim);
    margin-bottom: 12px;
  }
  .eco-group-title--out { color: var(--gold); }
  .eco-items { list-style: none; display: flex; flex-wrap: wrap; gap: 6px 14px; }
  .eco-items li {
    font-family: var(--font-heading);
    font-size: 0.98rem;
    color: var(--cream-dim);
  }
  .eco-items--out { flex-direction: column; gap: 9px; }
  .eco-items--out li { color: var(--cream); }
  .eco-bridge { display: flex; align-items: center; justify-content: center; position: relative; }
  .eco-bridge::before,
  .eco-bridge::after {
    content: '';
    position: absolute;
    left: 50%;
    width: 1px;
    height: 34%;
    background: linear-gradient(to bottom, transparent, rgba(201,168,76,0.3));
  }
  .eco-bridge::before { top: 0; }
  .eco-bridge::after { bottom: 0; transform: scaleY(-1); }
  .eco-bridge-glyph { color: var(--gold); opacity: 0.55; font-size: 1rem; }
  .eco-output {
    padding: 28px 26px;
    border: 1px solid rgba(201,168,76,0.28);
    border-radius: 10px;
    background: rgba(201,168,76,0.05);
  }
  .eco-close { margin: 64px auto 0; max-width: 580px; text-align: center; }
  .eco-close-line {
    font-family: var(--font-heading);
    font-size: clamp(1.5rem, 3.6vw, 2.2rem);
    font-style: italic;
    font-weight: 300;
    color: var(--gold-light);
  }
  .eco-close-body { margin-top: 20px; font-size: 1rem; line-height: 1.8; color: var(--cream-dim); }

  /* ── CAPABILITIES ── */
  .capabilities { padding: var(--section-pad) 0; background: var(--navy); }
  .capabilities .section-header { max-width: 620px; margin: 0 auto 56px; text-align: center; }
  .cap-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 40px;
    max-width: 960px;
    margin: 0 auto;
  }
  .cap { text-align: center; }
  .cap-title {
    font-family: var(--font-heading);
    font-size: 1.45rem;
    font-weight: 300;
    font-style: italic;
    color: var(--gold-light);
    margin-bottom: 16px;
  }
  .cap-body { font-family: var(--font-heading); font-size: 1.05rem; line-height: 1.65; color: var(--cream); }
  .cap-detail { margin-top: 14px; font-size: 0.87rem; line-height: 1.7; color: var(--cream-dim); opacity: 0.8; }

  /* ── PRICING / FINAL CTA additions ── */
  .pricing-transition { margin-top: 16px; }
  .cta-lead { font-size: 1.05rem; line-height: 1.7; }
  .cta-founders-link { color: var(--gold-dim); border-bottom: 1px solid rgba(138,111,48,0.4); }
  .cta-founders-link:hover { color: var(--gold); }

  /* ── RESPONSIVE ── */
  @media (max-width: 900px) {
    .depth-context { grid-template-columns: 1fr; gap: 26px; }
    .cap-grid { grid-template-columns: 1fr; gap: 44px; max-width: 460px; }
    .eco-map { grid-template-columns: 1fr; gap: 24px; max-width: 520px; }
    .eco-bridge { height: 40px; }
    .eco-bridge::before, .eco-bridge::after { height: 40%; }
    .eco-items--out { flex-direction: row; flex-wrap: wrap; gap: 6px 14px; }
  }
  @media (max-width: 600px) {
    .validation-title { margin-bottom: 36px; }
    .tension-resolve { font-size: 2.2rem; }
    .depth-moment { padding: 26px 20px; }
    .depth-land { margin-top: 52px; }
    .expansion-line { font-size: 1.04rem; padding: 9px 0; }
    .diff-list li { font-size: 0.95rem; }
    .diff-close { margin-top: 52px; padding-top: 36px; }
    .story-turn--solo { font-size: 1.35rem; }
  }


  /* ── SHOWCASE CLOSE ── */
  .showcase-close { padding: 0 0 var(--section-pad); background: var(--navy); text-align: center; }
  .showcase-close-text {
    max-width: 620px;
    margin: 0 auto;
    font-family: var(--font-heading);
    font-size: clamp(1.4rem, 3.4vw, 2.1rem);
    font-weight: 300;
    line-height: 1.45;
    color: var(--cream);
  }
  .showcase-close-text em { font-style: italic; color: var(--gold-light); }


  /* ── DEPTH payoff — image-led ── */
  .depth-land { margin: 84px auto 0; max-width: 880px; }
  .depth-land-img {
    position: relative;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid var(--navy-border);
    box-shadow: 0 30px 90px rgba(0,0,0,0.5);
  }
  .depth-land-img img { display: block; width: 100%; height: auto; }
  /* Hairline seam down the centre, echoing the split in the photograph */
  .depth-land-img::after {
    content: '';
    position: absolute;
    left: 50%; top: 8%; bottom: 8%;
    width: 1px;
    background: linear-gradient(to bottom, transparent, rgba(201,168,76,0.5), transparent);
  }
  .depth-land-tag {
    position: absolute;
    bottom: 16px;
    font-family: var(--font-display);
    font-size: 0.58rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--cream);
    background: rgba(8,12,24,0.68);
    padding: 6px 12px;
    border-radius: 3px;
    backdrop-filter: blur(3px);
  }
  .depth-land-tag--l { left: 16px; }
  .depth-land-tag--r { right: 16px; }
  .depth-land-text {
    margin-top: 44px;
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  /* Scan layer: the first three lines recede, the fourth is the one a
     scanner stops on. */
  .dl-line {
    font-family: var(--font-heading);
    font-size: clamp(1.1rem, 2.2vw, 1.5rem);
    font-weight: 300;
    line-height: 1.5;
    color: var(--cream-dim);
  }
  .dl-line--hit {
    margin-top: 14px;
    font-size: clamp(1.9rem, 4.6vw, 3rem);
    font-style: italic;
    line-height: 1.25;
    color: var(--gold-light);
  }
  @media (max-width: 600px) {
    .depth-land { margin-top: 56px; }
    .depth-land-text { margin-top: 30px; }
    .depth-land-tag { font-size: 0.5rem; padding: 5px 9px; bottom: 10px; }
    .depth-land-tag--l { left: 9px; }
    .depth-land-tag--r { right: 9px; }
  }


  /* ══════════ VISUAL UX PASS ══════════
     The page was a long column of centred text blocks. Scanners need
     anchors, alternation, and a clear payoff line per section. Three
     devices, applied consistently:
       1. lifestyle photography at the emotional beats (people, not
          abstraction - there was not a single human on the page before)
       2. broken symmetry: side-by-side and left-aligned compositions
          between the centred ones, so the eye keeps moving
       3. a scan layer - setup copy recedes, the payoff line is large,
          italic and gold, so a reader who only reads headlines still
          gets the argument */

  /* ── RECOGNITION: image + moments side by side ── */
  .validation-split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 46px;
    align-items: center;
    max-width: 1020px;
    margin: 0 auto;
  }
  .validation-figure {
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid var(--navy-border);
    box-shadow: 0 24px 70px rgba(0,0,0,0.45);
  }
  .validation-figure img { display: block; width: 100%; height: auto; }
  .validation-split .validation-lines { text-align: left; }
  .validation-split .validation-line { padding: 13px 0; }

  /* ── EXPANSION: ripple photograph + staircased lines ── */
  .expansion { position: relative; overflow: hidden; }
  .expansion-bg {
    position: absolute; inset: 0;
    background-image: url('/home-expansion.jpg');
    background-size: cover;
    background-position: center 62%;
    z-index: 0;
  }
  .expansion-overlay {
    position: absolute; inset: 0; z-index: 1;
    background: linear-gradient(to bottom,
      rgba(8,12,24,0.93) 0%, rgba(8,12,24,0.80) 40%,
      rgba(8,12,24,0.84) 70%, rgba(8,12,24,0.96) 100%);
  }
  .expansion .container { position: relative; z-index: 2; }
  /* Accumulation made visible: each line steps further in than the last,
     with a node on a shared vertical rule. */
  .expansion-lines {
    max-width: 560px;
    margin: 0 auto;
    text-align: left;
    padding-left: 18px;
    border-left: 1px solid rgba(201,168,76,0.22);
  }
  .expansion-line {
    position: relative;
    padding-left: calc(var(--step, 0) * 13px);
    transition: none;
  }
  .expansion-line::before {
    content: '';
    position: absolute;
    left: calc(var(--step, 0) * 13px - 22px);
    top: 1.05em;
    width: 5px; height: 5px;
    border-radius: 50%;
    background: var(--gold-dim);
    opacity: calc(0.35 + var(--step, 0) * 0.09);
  }

  /* ── DIFFERENTIATOR: left-aligned rows, not centred prose ── */
  .diff-list { text-align: left; }
  .diff-list li {
    position: relative;
    display: flex;
    gap: 14px;
    align-items: baseline;
    padding: 13px 0;
    border-bottom: 1px solid rgba(255,255,255,0.05);
  }
  .diff-list li:last-child { border-bottom: none; }
  .diff-q {
    flex-shrink: 0;
    font-family: var(--font-heading);
    font-size: 1.15rem;
    font-style: italic;
    color: var(--gold-dim);
    opacity: 0.8;
    line-height: 1.4;
  }

  /* ── FINAL CTA: photograph behind it ── */
  .final-cta { position: relative; overflow: hidden; }
  .final-bg {
    position: absolute; inset: 0;
    background-image: url('/home-final.jpg');
    background-size: cover;
    background-position: center 55%;
    z-index: 0;
  }
  .final-overlay {
    position: absolute; inset: 0; z-index: 1;
    background: linear-gradient(to bottom,
      rgba(8,12,24,0.90) 0%, rgba(8,12,24,0.74) 45%, rgba(8,12,24,0.95) 100%);
  }
  .final-cta .container { position: relative; z-index: 2; }

  @media (max-width: 860px) {
    .validation-split { grid-template-columns: 1fr; gap: 32px; max-width: 540px; }
    .validation-split .validation-lines { text-align: center; }
  }
  @media (max-width: 600px) {
    /* Staircase halves on mobile - full indent would eat the column */
    .expansion-line { padding-left: calc(var(--step, 0) * 6px); }
    .expansion-line::before { left: calc(var(--step, 0) * 6px - 22px); }
    .diff-list li { gap: 10px; padding: 11px 0; }
