  <script>
    // App screenshot carousel
    const appshotEl    = document.getElementById('appshot-scroll') as HTMLElement | null;
    const appshotCards = document.querySelectorAll<HTMLElement>('.appshot-card');
    const appshotDots  = document.querySelectorAll<HTMLElement>('#as-dots .sc-dot');
    let appshotCur = 0;
    const appshotTot = 8;

    function getAppshotPad() {
      if (!appshotEl) return 0;
      return parseInt(getComputedStyle(appshotEl).paddingLeft) || 0;
    }

    function appshotTo(idx: number) {
      appshotCur = ((idx % appshotTot) + appshotTot) % appshotTot;
      const card = appshotCards[appshotCur];
      if (card && appshotEl) {
        appshotEl.scrollTo({ left: card.offsetLeft - getAppshotPad(), behavior: 'smooth' });
      }
      appshotDots.forEach((d, i) => d.classList.toggle('active', i === appshotCur));
    }

    document.getElementById('as-prev')?.addEventListener('click', () => appshotTo(appshotCur - 1));
    document.getElementById('as-next')?.addEventListener('click', () => appshotTo(appshotCur + 1));
    appshotDots.forEach(d => d.addEventListener('click', () => appshotTo(Number(d.dataset.idx))));

    const APPSHOT_AUTOPLAY_MS = 9000;
    let appshotTimer = setInterval(() => appshotTo(appshotCur + 1), APPSHOT_AUTOPLAY_MS);
    appshotEl?.addEventListener('pointerdown', () => { clearInterval(appshotTimer); appshotTimer = setInterval(() => appshotTo(appshotCur + 1), APPSHOT_AUTOPLAY_MS); });

    if (typeof IntersectionObserver !== 'undefined' && appshotEl) {
      const ioShot = new IntersectionObserver(entries => {
        entries.forEach(e => {
          if (e.isIntersecting) {
            const i = Array.from(appshotCards).indexOf(e.target as HTMLElement);
            if (i !== -1) { appshotCur = i; appshotDots.forEach((d, j) => d.classList.toggle('active', j === i)); }
          }
        });
      }, { root: appshotEl, threshold: 0.55 });
      appshotCards.forEach(c => ioShot.observe(c));
    }

    // Click-to-enlarge lightbox
    const appshotLightbox    = document.getElementById('appshot-lightbox');
    const appshotLightboxImg = document.getElementById('appshot-lightbox-img') as HTMLImageElement | null;

    function openAppshotLightbox(img: HTMLImageElement) {
      if (!appshotLightbox || !appshotLightboxImg) return;
      clearInterval(appshotTimer); // don't keep auto-advancing the carousel underneath while the lightbox is open
      appshotLightboxImg.src = img.src;
      appshotLightboxImg.alt = img.alt;
      appshotLightbox.classList.add('open');
      document.body.style.overflow = 'hidden';
    }
    function closeAppshotLightbox() {
      if (!appshotLightbox) return;
      appshotLightbox.classList.remove('open');
      document.body.style.overflow = '';
      appshotTimer = setInterval(() => appshotTo(appshotCur + 1), APPSHOT_AUTOPLAY_MS);
    }

    document.querySelectorAll<HTMLImageElement>('.appshot-img').forEach(img => {
      img.addEventListener('click', () => openAppshotLightbox(img));
    });
    document.getElementById('appshot-lightbox-close')?.addEventListener('click', closeAppshotLightbox);
    appshotLightbox?.addEventListener('click', (e) => { if (e.target === appshotLightbox) closeAppshotLightbox(); });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeAppshotLightbox(); });
  </script>

