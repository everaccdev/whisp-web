  <script>
    // Scroll-depth-to-pricing (Phase 7) — the single number this whole
    // rework is meant to move. Fires once per visitor, first time any part
    // of the pricing section is actually on screen. This IS the
    // scroll-depth-to-founder-section event (Emotional Narrative Pass,
    // Phase 7) — same section, id="pricing" unchanged.
    const pricingSection = document.getElementById('pricing');
    if (pricingSection && typeof IntersectionObserver !== 'undefined') {
      let pricingSeen = false;
      const pricingIO = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting && !pricingSeen) {
            pricingSeen = true;
            (window as any).posthog?.capture('website_pricing_section_viewed');
            pricingIO.disconnect();
          }
        });
      }, { threshold: 0.2 });
      pricingIO.observe(pricingSection);
    }

    // Live founder counter (Emotional Narrative Pass, Phase 4) — same
    // /api/founder-count endpoint founders.astro already uses, not
    // duplicated logic. If Stripe is unreachable and there's no cached
    // count, the endpoint returns { available: false } and this hides the
    // pill entirely rather than showing a fabricated or stale-beyond-trust
    // number (same rule founders.astro follows).
    fetch('/api/founder-count')
      .then(r => r.json())
      .then(data => {
        const pill = document.getElementById('counter-pill-home');
        const num = document.getElementById('counter-num-home');
        if (!pill) return;
        if (!data.available) {
          pill.style.display = 'none';
          return;
        }
        if (data.capReached) {
          pill.dataset.state = 'capped';
          pill.innerHTML = '<span>All 500 founding spots are taken</span>';
        } else if (num) {
          num.textContent = String(data.remaining);
        }
      })
      .catch(() => {
        const pill = document.getElementById('counter-pill-home');
        if (pill) pill.style.display = 'none';
      });
  </script>

