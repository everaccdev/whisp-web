---
export const prerender = true;
import Base from '../layouts/Base.astro';
import { ACTIVE_HERO_VARIANT, HERO_VARIANTS, HERO_SPLIT_IDS } from '../lib/heroContent';
import WhispGlyph from '../components/whisp-glyphs/WhispGlyph.astro';
import WhispDivider from '../components/whisp-glyphs/WhispDivider.astro';
// ACTIVE_HERO_VARIANT is still what's server-rendered — the no-JS /
// first-paint default, same role the App Store link plays for the CTA
// below. The actual 3-way split now happens client-side (see the
// hero-variant-split script after the hero): a sticky per-visitor cookie
// picks A/B/C and swaps the DOM before the .fade-up entrance animation
// reveals it, so there's no flash for the ~2/3 of visitors not on the
// default. HERO_VARIANTS is passed into that script via define:vars.
const hero = ACTIVE_HERO_VARIANT;
---

<Base>
  <!-- ═══════════════ HERO ═══════════════ -->
  <section class="hero">
    <!-- Full-bleed painterly background -->
    <div class="hero-bg-img"></div>
    <div class="hero-overlay"></div>

    <div class="hero-content">
      <div class="hero-eyebrow fade-up">
        <span class="hero-glyph">✦</span>
        <span class="hero-label">A JOURNAL FOR SIGNS & SYNCHRONICITY</span>
      </div>

      <div class="hero-logo-wrap fade-up" style="animation-delay:0.08s">
        <span class="hero-logo-mark">✦ whisp</span>
      </div>

      <h1 class="hero-title fade-up" style="animation-delay:0.15s">
        <span id="hero-title-plain" set:html={hero.titlePlain}></span><br /><em id="hero-title-em" set:html={hero.titleEmphasis}></em>
      </h1>

      <div class="hero-rule fade-up" style="animation-delay:0.22s">
        <div class="rule-line"></div>
      </div>

      <p class="hero-sub fade-up" id="hero-sub" style="animation-delay:0.28s" set:html={hero.sub} />

      <!-- ONE dominant action, adaptively platform-detected (see script
           below) — was three competing CTAs (founders / iOS / Android).
           Server-rendered default (no-JS, or before detection runs) is the
           App Store, since that link always works regardless of platform.
           Both store badges stay visible underneath, subordinate, so a
           misdetection or desktop visitor can always pick correctly.
           Founders pricing is now a small text link, not a competing
           button — it belongs at the pricing section (moved up this
           rework), not duplicating the nav's own founders link here. -->
      <div class="hero-cta fade-up" style="animation-delay:0.36s">
        <a
          href="https://apps.apple.com/app/id6777561873"
          id="hero-primary-cta"
          class="btn btn-primary hero-primary-btn"
          data-analytics="hero_primary_cta"
        >
          <span id="hero-primary-cta-text">Start noticing ✦</span>
        </a>
        <div class="hero-cta-secondary">
          <a href="https://apps.apple.com/app/id6777561873" class="hero-store-badge" id="hero-badge-ios" data-analytics="hero_app_store_click">
            <svg class="btn-icon" viewBox="0 0 384 512" fill="currentColor" aria-hidden="true"><path d="M318.7 268.7c-.2-36.7 16.4-64.4 50-84.8-18.8-26.9-47.2-41.7-84.7-44.6-35.5-2.8-74.3 20.7-88.5 20.7-15 0-49.4-19.7-76.4-19.7C63.3 141 4 184.8 4 273.5q0 39.3 14.4 81.2c12.8 36.7 59 126.7 107.2 125.2 25.2-.6 43-17.9 75.8-17.9 31.8 0 48.3 17.9 76.4 17.9 48.6-.7 90.4-82.5 102.6-119.3-65.2-30.7-61.7-90-61.7-91.9zm-56.6-164.2c27.3-32.4 24.8-61.9 24-72.5-24.1 1.4-52 16.4-67.9 34.9-17.5 19.8-27.8 44.3-25.6 71.9 26.1 2 49.9-11.4 69.5-34.3z"/></svg>
            App Store
          </a>
          <a href="https://play.google.com/store/apps/details?id=com.eyeswidewellness.whisp&pcampaignid=web_share" class="hero-store-badge" id="hero-badge-android" data-analytics="hero_google_play_click">
            <svg class="btn-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M3 3.5v17a1 1 0 0 0 1.5.87l14-8.5a1 1 0 0 0 0-1.74l-14-8.5A1 1 0 0 0 3 3.5z"/></svg>
            Google Play
          </a>
        </div>
        <a href="/founders" class="hero-founders-link" data-analytics="hero_founders_link">Or lock in founder pricing →</a>
      </div>

      <p class="hero-note fade-up" style="animation-delay:0.44s">
        ✦ &nbsp;Free to start &nbsp;·&nbsp; iOS &amp; Android
      </p>
    </div>

    <div class="hero-scroll-hint">
      <span>Scroll</span>
      <div class="scroll-line"></div>
    </div>
  </section>

  <script>
    // Adaptive primary CTA — no new dependency, plain navigator.userAgent
    // sniffing (same tier of technique already used nowhere else on this
    // site, but simple and dependency-free). Runs after paint so the
    // server-rendered default (App Store) is what no-JS visitors and the
    // very first frame always see — no flash, no layout shift, degrades
    // to a working link either way.
    const ua = navigator.userAgent || '';
    const isAndroid = /Android/i.test(ua);
    const isIOS = /iPhone|iPad|iPod/i.test(ua) || (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);
    const primaryCta = document.getElementById('hero-primary-cta') as HTMLAnchorElement | null;
    const primaryCtaText = document.getElementById('hero-primary-cta-text');
    const ANDROID_URL = 'https://play.google.com/store/apps/details?id=com.eyeswidewellness.whisp&pcampaignid=web_hero';

    if (primaryCta && primaryCtaText) {
      // Label is now platform-agnostic ("Start noticing") so it reads as an
      // invitation rather than a download instruction — only the HREF adapts.
      if (isAndroid) {
        primaryCta.href = ANDROID_URL;
      } else if (isIOS) {
        // Already the server-rendered default — leave as-is.
      } else {
        // Desktop / unknown — App Store default stays as the primary
        // (both store badges are equally visible underneath regardless).
      }
    }
  </script>

  <script is:inline define:vars={{ variants: HERO_VARIANTS, splitIds: HERO_SPLIT_IDS, activeId: ACTIVE_HERO_VARIANT.id }}>
    // Hero copy split test. Real 3-way random split, sticky per visitor —
    // not a formal PostHog Experiment (that needs a feature flag created
    // in the PostHog dashboard, which is a config step on the account, not
    // something this script can do) but a fully analyzable one: hero_variant
    // is registered as a PostHog super-property, so it rides along on every
    // event this visitor fires afterward — pricing_section_viewed, CTA
    // clicks, checkout starts — and you can break any of those down by it
    // in a PostHog insight with no extra wiring.
    //
    // This page is static-prerendered (export const prerender = true), so
    // there's no per-request server to pick a variant — the swap happens
    // here, client-side, right after the CTA script above and BEFORE the
    // hero's .fade-up entrance animation reveals it (0.15s/0.28s delays),
    // so the ~2/3 of visitors not on the default variant see no flash.
    // No-JS visitors and the very first frame always see variant A, same
    // "server-rendered default" pattern the CTA button uses.
    (function () {
      var COOKIE = 'whisp_hero_variant';
      // Only the ids the split is currently running on — see HERO_SPLIT_IDS
      // in lib/heroContent.ts. A single entry means the split is paused.
      var IDS = splitIds && splitIds.length ? splitIds : Object.keys(variants);

      function getCookie(name) {
        var match = document.cookie.match(new RegExp('(?:^|; )' + name + '=([^;]*)'));
        return match ? decodeURIComponent(match[1]) : null;
      }
      function setCookie(name, value, days) {
        var expires = new Date(Date.now() + days * 24 * 60 * 60 * 1000).toUTCString();
        document.cookie = name + '=' + value + '; expires=' + expires + '; path=/; SameSite=Lax';
      }

      var variant = getCookie(COOKIE);
      var isNewAssignment = false;
      if (!variant || IDS.indexOf(variant) === -1) {
        variant = IDS[Math.floor(Math.random() * IDS.length)];
        setCookie(COOKIE, variant, 180); // sticky ~6 months — long enough to cover a slow purchase decision
        isNewAssignment = true;
      }

      // Swap only when the assigned variant differs from the one that was
      // server-rendered (activeId) — previously hardcoded to 'A'.
      if (variant !== activeId) {
        var v = variants[variant];
        var plainEl = document.getElementById('hero-title-plain');
        var emEl = document.getElementById('hero-title-em');
        var subEl = document.getElementById('hero-sub');
        if (plainEl) plainEl.innerHTML = v.titlePlain;
        if (emEl) emEl.innerHTML = v.titleEmphasis;
        if (subEl) subEl.innerHTML = v.sub;
      }

      // define:vars scripts are inline/plain JS, not TS-processed — no
      // `as any` cast here (unlike the optional-chained posthog calls
      // elsewhere on this page, which live in TS-processed scripts).
      if (window.posthog) {
        window.posthog.register({ hero_variant: variant });
        if (isNewAssignment) {
          window.posthog.capture('website_hero_variant_assigned', { hero_variant: variant });
        }
      }
    })();
  </script>

  <!-- ═══════════════ THE VALIDATION BEAT ═══════════════
       Emotional Narrative Pass, Phase 2. Job: make the visitor feel
       personally, specifically recognized before the page argues anything.
       Power is entirely in the specificity of the examples and the closing
       italic line — never generalize this copy. Visual UX pass added the
       lifestyle photograph beside the moments: the image does the
       identification work so the copy only has to name the feeling.
       Reuses the existing load-time .fade-up
       stagger already established on the hero — no new animation
       mechanism, and .fade-up already degrades to static under
       prefers-reduced-motion (see global.css). -->
  <section class="validation-beat" id="validation-beat">
    <!-- CSS nebula gradient behind everything (the old full-width
         feather-symbol.jpg ambient layer was removed as too clunky). The
         photograph added in the visual pass is a contained figure beside
         the copy, not a background wash — that was the distinction that
         made the earlier attempt fail. -->
    <div class="validation-bg" aria-hidden="true"></div>
    <div class="container">
      <div class="section-header">
        <h2 class="validation-title fade-up">You know when something feels<br /><em>a little too specific to ignore?</em></h2>
      </div>

      <!-- Image + moments side by side. The photograph is doing the
           identification work ("that is my room, that is my 11pm") so the
           copy doesn't have to describe the feeling as well as name it. -->
      <div class="validation-split">
        <div class="validation-figure fade-up">
          <img src="/home-recognition.jpg"
               alt="A woman in bed at dusk looking at her phone, a journal, crystals and a moon chart around her"
               loading="lazy" width="1500" height="844" />
        </div>
        <div class="validation-lines">
          <p class="validation-line fade-up" style="animation-delay:0.05s">11:11.<br /><span class="validation-line-beat">Again.</span></p>
          <p class="validation-line fade-up" style="animation-delay:0.15s">You dream about someone.<br /><span class="validation-line-beat">They call the next morning.</span></p>
          <p class="validation-line fade-up" style="animation-delay:0.25s">The same symbol appears three times<br /><span class="validation-line-beat">during the week you&rsquo;re considering a change.</span></p>
          <p class="validation-line fade-up" style="animation-delay:0.35s">A word you haven&rsquo;t thought about in years<br /><span class="validation-line-beat">suddenly seems to be everywhere.</span></p>
          <p class="validation-line validation-line--soft fade-up" style="animation-delay:0.45s">You half-laugh it off. You wonder if you&rsquo;re the only one who counts these.</p>
        </div>
      </div>

      <div class="validation-outro">
        <div class="validation-divider-wrap fade-up" style="animation-delay:0.52s">
          <WhispDivider glyph="spark" size={13} />
        </div>

        <p class="validation-hinge fade-up" style="animation-delay:0.6s">
          <em>You've never told anyone how often this actually happens.</em>
        </p>

        <!-- "It should feel almost like the final punctuation for the
             thought" — a small delicate feather, centered, drifting in
             just after the hinge line settles. -->
        <div class="validation-glyph-close">
          <WhispGlyph name="feather" size={34} animate="drift" delay={0.7} />
        </div>
      </div>
    </div>
  </section>

  <script>
    // Scroll-depth-to-validation-section (Emotional Narrative Pass, Phase 7)
    // — same one-shot IntersectionObserver pattern as the existing
    // website_demo_section_viewed / website_pricing_section_viewed events.
    const validationSection = document.getElementById('validation-beat');
    if (validationSection && typeof IntersectionObserver !== 'undefined') {
      let validationSeen = false;
      const validationIO = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting && !validationSeen) {
            validationSeen = true;
            (window as any).posthog?.capture('website_validation_section_viewed');
            validationIO.disconnect();
          }
        });
      }, { threshold: 0.4 });
      validationIO.observe(validationSection);
    }
  </script>

  <!-- ═══════════════ SIGNS COME IN EVERY FORM ═══════════════
       Addresses an objection the page never explicitly answered: that
       Whisp is only for astrology/numerology people. One visual, tight
       copy — not a new interactive section, deliberately lean so it
       doesn't compete with the demo section above it for attention. -->
  <section class="signs-variety">
    <div class="container">
      <div class="section-header">
        <span class="section-label">Not just numbers. Not just astrology.</span>
        <h2 class="section-title">A sign can be almost anything.</h2>
        <p class="section-sub">
          A repeating number. An animal that crosses your path twice. A dream you can't shake.
          A card that falls out of a deck. Whisp doesn't require a belief system to start —
          just something that caught your attention.
        </p>
      </div>
      <div class="signs-visual fade-up">
        <img
          src="/signs-collage.jpg"
          alt="A collage of the kinds of signs people log in Whisp: repeating numbers, animal encounters, dreams, and objects"
          loading="lazy"
        />
      </div>
    </div>
  </section>

  <!-- ═══════════════ LOOKING CLOSER ═══════════════
       Replaces the old memory beat ("You notice it / and then you forget
       it / Whisp doesn't"). That version was clever but framed Whisp as
       the thing keeping watch while the user forgot — an app that knows
       you better than you know yourself. The emotional proposition is
       DISCOVERY, not memory: the reader is the one looking closer, and
       Whisp is the lens. Three beats, escalating, ending on something
       that opens rather than resolves. -->
  <section class="tension-beat" id="tension-beat">
    <div class="container">
      <div class="section-header">
        <p class="tension-step fade-up" style="animation-delay:0.05s">One moment can make you wonder.</p>
        <p class="tension-step fade-up" style="animation-delay:0.2s">A few can make you look closer.</p>

        <!-- This line carries the section. Nothing explanatory follows it
             on purpose - the next section opens the expansion instead. -->
        <p class="tension-resolve fade-up" style="animation-delay:0.4s">
          Put them together, and<br /><em>something else can come into view.</em>
        </p>

        <div class="tension-glyph-close">
          <WhispGlyph name="sign-diamond" size={22} animate="brighten" delay={1} />
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════ DEPTH — EVERYTHING INSIDE ONE MOMENT ═══════════════
       The page's other argument is breadth-across-TIME. This one is
       depth-within-a-single-entry, and it is the section that stops Whisp
       reading as a symbol dictionary.

       Every context source below is verified against the shipped app -
       logInsightService.js assembles exactly these into the reflection
       prompt: personal meaning for the symbol, whatWasHappening (flagged
       in the prompt itself as "the single most important piece of
       context"), lifeContext, mood/moodLabel with valence and energy,
       somatic state and sensations, lifeAreaTags, occurrenceCount, and
       co-occurring symbols. Beliefs come via claudeService's
       buildBeliefContext (only beliefs the user actually selected), and
       sacred text via logInsightService's SCRIPTURE_TRADITIONS.

       The somatic words used below (Chills, Gut drop, Calm wash, Tension,
       Expansion, Warmth) are the app's own sensation labels from
       somaticUtils.js - not invented adjectives.

       Deliberately NOT an icon grid: the moment sits at the centre and the
       context converges on it. Do not "simplify" this into four cards with
       icons - that would make the capability feel ordinary, which is the
       exact failure this section exists to avoid. -->
  <section class="depth" id="depth">
    <div class="container">
      <div class="section-header">
        <h2 class="depth-open fade-up">One moment<br /><em>can hold a lot.</em></h2>
        <p class="depth-sub fade-up">
          A generic interpretation can tell you what a white butterfly traditionally symbolises.
          Open one in Whisp and there can be far more inside it than a definition.
        </p>
      </div>

      <div class="depth-composition">
        <div class="depth-moment fade-up">
          <span class="depth-moment-label">The moment</span>
          <p class="depth-moment-text">You keep seeing<br /><em>a white butterfly.</em></p>
        </div>

        <div class="depth-context">
          <div class="depth-ctx fade-up">
            <h3 class="depth-ctx-label">Your beliefs</h3>
            <p class="depth-ctx-text">What this symbol holds inside the traditions and frameworks you actually chose &mdash; and none of the ones you didn&rsquo;t.</p>
          </div>
          <div class="depth-ctx fade-up">
            <h3 class="depth-ctx-label">Sacred traditions &amp; texts</h3>
            <p class="depth-ctx-text">Where it appears across the scriptures and lineages that matter to you, if any do.</p>
          </div>
          <div class="depth-ctx fade-up">
            <h3 class="depth-ctx-label">Your inner world</h3>
            <p class="depth-ctx-text">Archetype, shadow, dream symbolism, and the psychological lenses you&rsquo;ve added.</p>
          </div>
          <div class="depth-ctx fade-up">
            <h3 class="depth-ctx-label">Your body</h3>
            <p class="depth-ctx-text">Chills. Gut drop. Calm wash. Tension. Expansion. Warmth. What happened in you when it appeared.</p>
          </div>
          <div class="depth-ctx fade-up">
            <h3 class="depth-ctx-label">Your emotional state</h3>
            <p class="depth-ctx-text">What you were feeling in that moment &mdash; and only if you said so.</p>
          </div>
          <div class="depth-ctx fade-up">
            <h3 class="depth-ctx-label">Your life right now</h3>
            <p class="depth-ctx-text">What was happening around it, in your words. This one matters more than all the rest.</p>
          </div>
          <div class="depth-ctx fade-up">
            <h3 class="depth-ctx-label">What you&rsquo;re seeking</h3>
            <p class="depth-ctx-text">The questions and themes you&rsquo;ve been carrying lately.</p>
          </div>
          <div class="depth-ctx fade-up">
            <h3 class="depth-ctx-label">Your intentions</h3>
            <p class="depth-ctx-text">What you&rsquo;ve been consciously moving toward &mdash; and how long it&rsquo;s been open.</p>
          </div>
        </div>
      </div>

      <!-- The payoff is carried by the IMAGE, not the copy. Two people,
           different ages, different frameworks (a crucifix and family
           photographs on one side; Jung, astrology and moon charts on the
           other), the same white butterfly at both windows, the same look
           on both faces. The four lines underneath only name what the
           reader has already seen. -->
      <figure class="depth-land fade-up">
        <div class="depth-land-img">
          <img src="/home-two-lives.jpg"
               alt="Two women in different homes, one with family photographs and a worn Bible, one with books on Jung and astrology, both looking up at a white butterfly at the window"
               loading="lazy" width="1600" height="900" />
          <span class="depth-land-tag depth-land-tag--l">Same butterfly.</span>
          <span class="depth-land-tag depth-land-tag--r">Same morning.</span>
        </div>
        <figcaption class="depth-land-text">
          <span class="dl-line">Same symbol.</span>
          <span class="dl-line">Different person.</span>
          <span class="dl-line">Different life.</span>
          <span class="dl-line dl-line--hit">Different reflection.</span>
        </figcaption>
      </figure>
    </div>
  </section>

  <script>
    // Pairs with website_demo_section_viewed - the two halves of the
    // differentiation argument (depth per moment vs. memory across time),
    // tracked separately so we can see which one holds attention.
    const depthSection = document.getElementById('depth');
    if (depthSection && typeof IntersectionObserver !== 'undefined') {
      let depthSeen = false;
      const depthIO = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting && !depthSeen) {
            depthSeen = true;
            (window as any).posthog?.capture('website_depth_section_viewed');
            depthIO.disconnect();
          }
        });
      }, { threshold: 0.35 });
      depthIO.observe(depthSection);
    }
  </script>

  <!-- ═══════════════ REAL USER STORIES ═══════════════
       NOT a testimonial section. No quotations, no names, no avatars, no
       ratings. These are real experiences users shared with the founder,
       retold in third person with identifying detail deliberately removed
       - which is both accurate and legally clean (the FTC's 2024 rule on
       consumer reviews prohibits fabricated endorsements; retold
       experience presented as such is not an endorsement).

       The three cards are STRATEGICALLY DIFFERENT and must stay that way:
         card 1 = DEPTH within a single moment
         card 2 = CONNECTION across time
         card 3 = MEANING through personal life context
       Do not rewrite these into three versions of "Whisp found a pattern" -
       and keep the USER as the protagonist, never the product.
       That collapse would destroy the point of the section. -->
  <section class="stories" id="stories">
    <div class="stories-bg"></div>
    <div class="stories-overlay"></div>
    <div class="container">
      <div class="section-header">
        <h2 class="section-title">They logged one thing.<br /><em>Then something came into view.</em></h2>
        <p class="section-sub">
          A dream you almost forgot. A thread running through months. Something you&rsquo;ve been
          circling without knowing how to name it. Sometimes a reflection lands differently
          when it comes from your own life.
        </p>
      </div>

      <div class="stories-grid">
        <article class="story fade-up">
          <span class="story-mark" aria-hidden="true">&#10022;</span>
          <h3 class="story-label">The dream she couldn&rsquo;t shake</h3>
          <p class="story-text">
            Her father had been gone for years.
          </p>
          <p class="story-text">
            Then she dreamed of him standing on a staircase disappearing beneath his feet.
            She logged it before the details faded.
          </p>
          <p class="story-turn">It stayed with her for days.</p>
        </article>

        <article class="story fade-up">
          <span class="story-mark" aria-hidden="true">&#10022;</span>
          <h3 class="story-label">The pattern she didn&rsquo;t see</h3>
          <p class="story-text">
            For months, she&rsquo;d been logging the same numbers through a difficult chapter of
            self-love, boundaries and letting go.
          </p>
          <p class="story-text">
            Seeing those moments together brought something into focus she hadn&rsquo;t
            been able to name.
          </p>
          <p class="story-turn story-turn--solo">She cried.</p>
          <p class="story-coda">Then she made the decision she&rsquo;d been circling for months.</p>
        </article>

        <article class="story fade-up">
          <span class="story-mark" aria-hidden="true">&#10022;</span>
          <h3 class="story-label">The dream that made him stop</h3>
          <p class="story-text">
            Everything in his life felt out of control.
          </p>
          <p class="story-text">
            Then came a dream: cars he couldn&rsquo;t steer, a crash he couldn&rsquo;t prevent,
            his children in the back seat.
          </p>
          <p class="story-text">
            The reflection helped him see something about how he was carrying it all that
            he hadn&rsquo;t been able to see before.
          </p>
          <p class="story-turn">It made him face it.</p>
        </article>
      </div>

      <div class="stories-close-block fade-up">
        <p class="stories-question">What might you<br /><em>see in yours?</em></p>
        <a href="https://apps.apple.com/app/id6777561873" class="stories-cta" data-analytics="stories_cta">Start noticing &rarr;</a>
      </div>

      <p class="stories-note">
        Based on real experiences shared by Whisp users. Details are intentionally limited
        to protect the reflections that belong to them.
      </p>
    </div>
  </section>

  <!-- ═══ EXPANSION ═══
       The bridge from DEPTH-WITHIN-AN-ENTRY to CONNECTIONS-BETWEEN-ENTRIES.
       Deliberately unhurried: each line is its own beat, and the section
       resolves on a line that opens rather than closes. Do NOT add
       explanatory copy after the final line - the pattern section below
       is the explanation. -->
  <section class="expansion" id="expansion">
