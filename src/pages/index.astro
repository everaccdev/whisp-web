---
export const prerender = true;
import Base from '../layouts/Base.astro';
import { ACTIVE_HERO_VARIANT } from '../lib/heroContent';
import WhispGlyph from '../components/whisp-glyphs/WhispGlyph.astro';
import WhispDivider from '../components/whisp-glyphs/WhispDivider.astro';
const hero = ACTIVE_HERO_VARIANT;
---

<Base>
  <!-- ═══════════════ HERO ═══════════════ -->
  <section class="hero">
    <!-- Full-bleed painterly background -->
    <div class="hero-bg-img"></div>
    <div class="hero-overlay"></div>

    <div class="hero-content">
      <div class="hero-eyebrow fade-up">
        <span class="hero-glyph">✦</span>
        <span class="hero-label">A JOURNAL FOR SIGNS & SYNCHRONICITY</span>
      </div>

      <div class="hero-logo-wrap fade-up" style="animation-delay:0.08s">
        <span class="hero-logo-mark">✦ whisp</span>
      </div>

      <h1 class="hero-title fade-up" style="animation-delay:0.15s">
        {hero.titlePlain}<br /><em>{hero.titleEmphasis}</em>
      </h1>

      <div class="hero-rule fade-up" style="animation-delay:0.22s">
        <div class="rule-line"></div>
      </div>

      <p class="hero-sub fade-up" style="animation-delay:0.28s" set:html={hero.sub} />

      <!-- ONE dominant action, adaptively platform-detected (see script
           below) — was three competing CTAs (founders / iOS / Android).
           Server-rendered default (no-JS, or before detection runs) is the
           App Store, since that link always works regardless of platform.
           Both store badges stay visible underneath, subordinate, so a
           misdetection or desktop visitor can always pick correctly.
           Founders pricing is now a small text link, not a competing
           button — it belongs at the pricing section (moved up this
           rework), not duplicating the nav's own founders link here. -->
      <div class="hero-cta fade-up" style="animation-delay:0.36s">
        <a
          href="https://apps.apple.com/app/id6777561873"
          id="hero-primary-cta"
          class="btn btn-primary hero-primary-btn"
          data-analytics="hero_primary_cta"
        >
          <span id="hero-primary-cta-text">Download for iOS ✦</span>
        </a>
        <div class="hero-cta-secondary">
          <a href="https://apps.apple.com/app/id6777561873" class="hero-store-badge" id="hero-badge-ios" data-analytics="hero_app_store_click">
            <svg class="btn-icon" viewBox="0 0 384 512" fill="currentColor" aria-hidden="true"><path d="M318.7 268.7c-.2-36.7 16.4-64.4 50-84.8-18.8-26.9-47.2-41.7-84.7-44.6-35.5-2.8-74.3 20.7-88.5 20.7-15 0-49.4-19.7-76.4-19.7C63.3 141 4 184.8 4 273.5q0 39.3 14.4 81.2c12.8 36.7 59 126.7 107.2 125.2 25.2-.6 43-17.9 75.8-17.9 31.8 0 48.3 17.9 76.4 17.9 48.6-.7 90.4-82.5 102.6-119.3-65.2-30.7-61.7-90-61.7-91.9zm-56.6-164.2c27.3-32.4 24.8-61.9 24-72.5-24.1 1.4-52 16.4-67.9 34.9-17.5 19.8-27.8 44.3-25.6 71.9 26.1 2 49.9-11.4 69.5-34.3z"/></svg>
            App Store
          </a>
          <a href="https://play.google.com/store/apps/details?id=com.eyeswidewellness.whisp&pcampaignid=web_share" class="hero-store-badge" id="hero-badge-android" data-analytics="hero_google_play_click">
            <svg class="btn-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M3 3.5v17a1 1 0 0 0 1.5.87l14-8.5a1 1 0 0 0 0-1.74l-14-8.5A1 1 0 0 0 3 3.5z"/></svg>
            Google Play
          </a>
        </div>
        <a href="/founders" class="hero-founders-link" data-analytics="hero_founders_link">Or lock in founder pricing →</a>
      </div>

      <p class="hero-note fade-up" style="animation-delay:0.44s">
        ✦ &nbsp;Free to start &nbsp;·&nbsp; iOS & Android &nbsp;·&nbsp; Founder rate locked for early members
      </p>
    </div>

    <div class="hero-scroll-hint">
      <span>Scroll</span>
      <div class="scroll-line"></div>
    </div>
  </section>

  <script>
    // Adaptive primary CTA — no new dependency, plain navigator.userAgent
    // sniffing (same tier of technique already used nowhere else on this
    // site, but simple and dependency-free). Runs after paint so the
    // server-rendered default (App Store) is what no-JS visitors and the
    // very first frame always see — no flash, no layout shift, degrades
    // to a working link either way.
    const ua = navigator.userAgent || '';
    const isAndroid = /Android/i.test(ua);
    const isIOS = /iPhone|iPad|iPod/i.test(ua) || (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);
    const primaryCta = document.getElementById('hero-primary-cta') as HTMLAnchorElement | null;
    const primaryCtaText = document.getElementById('hero-primary-cta-text');
    const ANDROID_URL = 'https://play.google.com/store/apps/details?id=com.eyeswidewellness.whisp&pcampaignid=web_hero';

    if (primaryCta && primaryCtaText) {
      if (isAndroid) {
        primaryCta.href = ANDROID_URL;
        primaryCtaText.textContent = 'Download for Android ✦';
      } else if (isIOS) {
        // Already the server-rendered default — leave as-is.
      } else {
        // Desktop / unknown — App Store default stays as the primary
        // (both store badges are equally visible underneath regardless).
      }
    }
  </script>

  <!-- ═══════════════ THE VALIDATION BEAT ═══════════════
       Emotional Narrative Pass, Phase 2. Job: make the visitor feel
       personally, specifically recognized before the page argues anything.
       Power is entirely in the specificity of the examples and the closing
       italic line — never generalize this copy. Visual is deliberately
       restrained (CSS-only dark/nebula gradient, no image) so nothing
       competes with the text. Reuses the existing load-time .fade-up
       stagger already established on the hero — no new animation
       mechanism, and .fade-up already degrades to static under
       prefers-reduced-motion (see global.css). -->
  <section class="validation-beat" id="validation-beat">
    <!-- CSS nebula gradient only — the feather-symbol.jpg ambient
         background layer was removed (too clunky as a large image behind
         the copy). The spark divider and closing feather glyph stayed —
         those read fine on their own; only the background image was the
         problem. -->
    <div class="validation-bg" aria-hidden="true"></div>
    <div class="container">
      <div class="section-header">
        <span class="section-label fade-up">You know this feeling</span>
      </div>
      <div class="validation-lines">
        <p class="validation-line fade-up" style="animation-delay:0.05s">11:11 again — and that small jolt, right in your chest.</p>
        <p class="validation-line fade-up" style="animation-delay:0.15s">The same word, from three different people, in one day.</p>
        <p class="validation-line fade-up" style="animation-delay:0.25s">A dream about someone, and then they call.</p>
        <p class="validation-line validation-line--soft fade-up" style="animation-delay:0.35s">You half-laugh it off. You wonder if you're the only one who counts these.</p>

        <div class="fade-up" style="animation-delay:0.4s">
          <WhispDivider glyph="spark" size={13} class="validation-divider" />
        </div>

        <p class="validation-hinge fade-up" style="animation-delay:0.48s">
          <em>You've never told anyone how often this actually happens.</em>
        </p>

        <!-- "It should feel almost like the final punctuation for the
             thought" — a small delicate feather, centered, drifting in
             just after the hinge line settles. -->
        <div class="validation-glyph-close">
          <WhispGlyph name="feather" size={34} animate="drift" delay={0.7} />
        </div>
      </div>
    </div>
  </section>

  <script>
    // Scroll-depth-to-validation-section (Emotional Narrative Pass, Phase 7)
    // — same one-shot IntersectionObserver pattern as the existing
    // website_demo_section_viewed / website_pricing_section_viewed events.
    const validationSection = document.getElementById('validation-beat');
    if (validationSection && typeof IntersectionObserver !== 'undefined') {
      let validationSeen = false;
      const validationIO = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting && !validationSeen) {
            validationSeen = true;
            (window as any).posthog?.capture('website_validation_section_viewed');
            validationIO.disconnect();
          }
        });
      }, { threshold: 0.4 });
      validationIO.observe(validationSection);
    }
  </script>

  <!-- ═══════════════ THE TENSION BEAT ═══════════════
       Phase 3. Short, on purpose — its entire job is the felt gap between
       the recognition above and the demonstration below. Closing line is
       the first appearance of Whisp as the answer; it should read as
       relief, not a pitch. -->
  <section class="tension-beat" id="tension-beat">
    <div class="container">
      <div class="section-header">
        <span class="section-label fade-up">But the moment passes</span>
        <p class="tension-body fade-up" style="animation-delay:0.1s">
          You notice. You feel it. Then the day moves on, and by next week the details have already softened.
          If it happens again in three months, you won't remember this happened at all.
        </p>

        <p class="tension-resolve fade-up" style="animation-delay:0.3s">
          <em>Whisp remembers what stands out — even when you don't.</em>
        </p>

        <div class="tension-glyph-close">
          <WhispGlyph name="sign-diamond" size={22} animate="brighten" delay={1} />
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════ DEMONSTRATE THE PATTERN ═══════════════
       Homepage Conversion Rework Phase 2, refined in the Emotional
       Narrative Pass — the single highest-leverage section on the page.
       Shows accumulation rather than describing it, resolving the tension
       beat above: "you weren't imagining it." The explicit ChatGPT
       comparison used to be this section's own label — moved down to the
       FAQ (Emotional Narrative Pass, Phase 6) so the underlying
       differentiation idea (memory across time vs. one lookup) stays high
       without spending the visitor's first real objection this early. The
       timeline below is explicitly illustrative (labelled as such), not a
       live backend call or a real user's data — it's modeled on what
       Whisp's actual detectors do (patternEngine.js: frequency surges,
       dream/waking overlap, cross-entry-type recurrence across
       signs/dreams/journal), not invented functionality. -->
  <section class="demo-pattern" id="demo-pattern">
    <div class="container">
      <div class="section-header">
        <span class="section-label">You weren't imagining it</span>
        <h2 class="section-title">One sign is a curiosity.<br /><em>A pattern is something a single lookup can't see.</em></h2>
        <p class="section-sub">
          Ask a chatbot what a number means and the context evaporates the moment you close the tab.
          Whisp remembers across weeks — here's the shape of what that looks like.
        </p>
      </div>

      <div class="demo-visual fade-up">
        <img
          src="/demo-pattern.jpg"
          alt="Whisp noticing a recurring theme across signs, dreams, and journal entries"
          loading="lazy"
          class="demo-visual-img"
        />
      </div>

      <div class="demo-timeline fade-up" role="list" aria-label="Illustrative example, not a real user's data">
        <div class="demo-beat" role="listitem"><span class="demo-beat-day">Day 1</span><span class="demo-beat-sign">11:11</span></div>
        <div class="demo-beat-arrow" aria-hidden="true">↓</div>
        <div class="demo-beat" role="listitem"><span class="demo-beat-day">Day 6</span><span class="demo-beat-sign">a white butterfly</span></div>
        <div class="demo-beat-arrow" aria-hidden="true">↓</div>
        <div class="demo-beat" role="listitem"><span class="demo-beat-day">Day 11</span><span class="demo-beat-sign">a dream about leaving home</span></div>
        <div class="demo-beat-arrow" aria-hidden="true">↓</div>
        <div class="demo-beat" role="listitem"><span class="demo-beat-day">Day 17</span><span class="demo-beat-sign">a journal entry about a career change</span></div>
        <div class="demo-beat-arrow" aria-hidden="true">↓</div>
        <div class="demo-beat" role="listitem"><span class="demo-beat-day">Day 23</span><span class="demo-beat-sign">11:11 again</span></div>
      </div>

      <div class="demo-result fade-up">
        <span class="demo-result-label">✦ WHISP NOTICES</span>
        <p class="demo-result-text">Transition keeps appearing — across your signs, your dreams, and what you've written.</p>
      </div>

      <p class="demo-caveat">
        Illustrative example, not a specific person's data — modeled on how Whisp's real pattern
        detection actually works: recurring symbols, dream-and-waking overlap, and themes that
        span your signs, dreams, and journal at once.
      </p>
    </div>
  </section>

  <script>
    // Fires once per visitor when the demonstration section first enters
    // view — the "did the differentiation land" signal (Phase 7).
    const demoSection = document.getElementById('demo-pattern');
    if (demoSection && typeof IntersectionObserver !== 'undefined') {
      let demoSeen = false;
      const demoIO = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting && !demoSeen) {
            demoSeen = true;
            (window as any).posthog?.capture('website_demo_section_viewed');
            demoIO.disconnect();
          }
        });
      }, { threshold: 0.4 });
      demoIO.observe(demoSection);
    }
  </script>

  <!-- ═══════════════ SIGNS COME IN EVERY FORM ═══════════════
       Addresses an objection the page never explicitly answered: that
       Whisp is only for astrology/numerology people. One visual, tight
       copy — not a new interactive section, deliberately lean so it
       doesn't compete with the demo section above it for attention. -->
  <section class="signs-variety">
    <div class="container">
      <div class="section-header">
        <span class="section-label">Not just numbers. Not just astrology.</span>
        <h2 class="section-title">A sign can be almost anything.</h2>
        <p class="section-sub">
          A repeating number. An animal that crosses your path twice. A dream you can't shake.
          A card that falls out of a deck. Whisp doesn't require a belief system to start —
          just something that caught your attention.
        </p>
      </div>
      <div class="signs-visual fade-up">
        <img
          src="/signs-collage.jpg"
          alt="A collage of signs Whisp tracks: repeating numbers, animal encounters, dreams, and objects"
          loading="lazy"
        />
      </div>
    </div>
  </section>

  <!-- ═══════════════ APP SHOWCASE ═══════════════ -->
  <section class="showcase" id="showcase">
    <div class="container">
      <div class="section-header">
        <span class="section-label">Inside Whisp</span>
        <h2 class="section-title">Every sign has a home</h2>
        <p class="section-sub">Beautiful, minimal, and built around what you actually believe.</p>
      </div>
    </div>

    <div class="appshot-scroll" id="appshot-scroll">
      <div class="appshot-card">
        <img class="appshot-img" src="/device-1.jpg" alt="Whisp home screen showing your journey this week and a noticed pattern" loading="lazy" />
        <p class="appshot-caption">Your week, gathered into one view</p>
      </div>
      <div class="appshot-card">
        <img class="appshot-img" src="/device-2.jpg" alt="Journal timeline with a thread forming across recent entries" loading="lazy" />
        <p class="appshot-caption">A thread is forming — Whisp says so</p>
      </div>
      <div class="appshot-card">
        <img class="appshot-img" src="/device-4.jpg" alt="Sign log for a hummingbird with Whisp's personal reflection" loading="lazy" />
        <p class="appshot-caption">Every sign, a personal reflection</p>
      </div>
      <div class="appshot-card">
        <img class="appshot-img" src="/device-3.jpg" alt="Weekly Insights weave with a written reading for the week" loading="lazy" />
        <p class="appshot-caption">A weekly reading, written just for you</p>
      </div>
      <div class="appshot-card">
        <img class="appshot-img" src="/device-6.jpg" alt="Sacred Tools screen browsing the Rider-Waite tarot deck" loading="lazy" />
        <p class="appshot-caption">Ancient tools, held in your pocket</p>
      </div>
      <div class="appshot-card">
        <img class="appshot-img" src="/device-7.jpg" alt="Chakra Insights and Celestial screens side by side" loading="lazy" />
        <p class="appshot-caption">Energy centers and the sky, tracked together</p>
      </div>
      <div class="appshot-card">
        <img class="appshot-img" src="/device-5.jpg" alt="Vision Board screen titled Life I'm building" loading="lazy" />
        <p class="appshot-caption">A vision board for the life you're building</p>
      </div>
      <div class="slides-spacer"></div>
    </div>

    <div class="slides-nav">
      <button class="sc-btn" id="as-prev" aria-label="Previous">←</button>
      <div class="sc-dots" id="as-dots">
        <button class="sc-dot active" data-idx="0"></button>
        <button class="sc-dot" data-idx="1"></button>
        <button class="sc-dot" data-idx="2"></button>
        <button class="sc-dot" data-idx="3"></button>
        <button class="sc-dot" data-idx="4"></button>
        <button class="sc-dot" data-idx="5"></button>
        <button class="sc-dot" data-idx="6"></button>
      </div>
      <button class="sc-btn" id="as-next" aria-label="Next">→</button>
    </div>
  </section>

  <script>
    // App screenshot carousel
    const appshotEl    = document.getElementById('appshot-scroll') as HTMLElement | null;
    const appshotCards = document.querySelectorAll<HTMLElement>('.appshot-card');
    const appshotDots  = document.querySelectorAll<HTMLElement>('#as-dots .sc-dot');
    let appshotCur = 0;
    const appshotTot = 7;

    function getAppshotPad() {
      if (!appshotEl) return 0;
      return parseInt(getComputedStyle(appshotEl).paddingLeft) || 0;
    }

    function appshotTo(idx: number) {
      appshotCur = ((idx % appshotTot) + appshotTot) % appshotTot;
      const card = appshotCards[appshotCur];
      if (card && appshotEl) {
        appshotEl.scrollTo({ left: card.offsetLeft - getAppshotPad(), behavior: 'smooth' });
      }
      appshotDots.forEach((d, i) => d.classList.toggle('active', i === appshotCur));
    }

    document.getElementById('as-prev')?.addEventListener('click', () => appshotTo(appshotCur - 1));
    document.getElementById('as-next')?.addEventListener('click', () => appshotTo(appshotCur + 1));
    appshotDots.forEach(d => d.addEventListener('click', () => appshotTo(Number(d.dataset.idx))));

    let appshotTimer = setInterval(() => appshotTo(appshotCur + 1), 5000);
    appshotEl?.addEventListener('pointerdown', () => { clearInterval(appshotTimer); appshotTimer = setInterval(() => appshotTo(appshotCur + 1), 5000); });

    if (typeof IntersectionObserver !== 'undefined' && appshotEl) {
      const ioShot = new IntersectionObserver(entries => {
        entries.forEach(e => {
          if (e.isIntersecting) {
            const i = Array.from(appshotCards).indexOf(e.target as HTMLElement);
            if (i !== -1) { appshotCur = i; appshotDots.forEach((d, j) => d.classList.toggle('active', j === i)); }
          }
        });
      }, { root: appshotEl, threshold: 0.55 });
      appshotCards.forEach(c => ioShot.observe(c));
    }
  </script>

  <!-- ═══════════════ FEATURES ═══════════════ -->
  <section class="features" id="features">
    <div class="container">
      <div class="section-header">
        <span class="section-label">What Whisp does</span>
        <h2 class="section-title">Your signs. Your meaning.</h2>
        <p class="section-sub">
          Not generic horoscopes. Not one-size-fits-all interpretations.<br />
          Whisp learns how you make meaning — and interprets through the lenses you choose.
        </p>
      </div>

      <div class="features-grid">
        <div class="feature-card feature-card--large">
          <div class="feature-icon">◐</div>
          <h3>Sign & Dream Logging</h3>
          <p>Capture repeating numbers, animals, dreams, and symbols the moment they happen. Quick, frictionless, and beautiful.</p>
          <div class="feature-tag">Core</div>
        </div>

        <div class="feature-card">
          <div class="feature-icon">⟁</div>
          <h3>Pattern Intelligence</h3>
          <p>Whisp surfaces correlations across your logs — symbols that cluster around emotional states, moon phases, or life events.</p>
          <div class="feature-tag feature-tag--gold">Premium</div>
        </div>

        <div class="feature-card">
          <div class="feature-icon">◎</div>
          <h3>Personal Symbol Library</h3>
          <p>Every symbol builds a profile over time. See frequency, emotional tone, and personalized reflections that remember your beliefs.</p>
          <div class="feature-tag feature-tag--gold">Premium</div>
        </div>

        <div class="feature-card">
          <div class="feature-icon">☽</div>
          <h3>Celestial Context</h3>
          <p>Moon phases, retrogrades, eclipses, and your natal chart woven into every log — gated by what you actually believe in.</p>
          <div class="feature-tag">Core</div>
        </div>

        <div class="feature-card feature-card--large">
          <div class="feature-icon">✦</div>
          <h3>Belief-Aware Reflections</h3>
          <p>Choose how you make meaning — astrology, numerology, Jungian, spiritual, secular — and Whisp only draws on the lenses you've selected. Your meaning, not ours.</p>
          <div class="feature-tag feature-tag--gold">Premium</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════ PHILOSOPHY ═══════════════ -->
  <section class="philosophy">
    <div class="philosophy-bg"></div>
    <div class="philosophy-overlay"></div>
    <div class="container">
      <div class="philosophy-inner">
        <div class="philosophy-glyph" aria-hidden="true">✦</div>
        <blockquote class="philosophy-quote">
          "The universe speaks in symbols.<br />Whisp helps you learn the language."
        </blockquote>
        <p class="philosophy-body">
          We believe meaning isn't universal — it's personal. What a crow means to you is shaped by your history, your beliefs, your culture, and the moment it appeared.
          Whisp doesn't tell you what your signs mean. It helps you discover it yourself.
        </p>
      </div>
    </div>
  </section>

  <!-- ═══════════════ PRICING ═══════════════
       Emotional Narrative Pass, Phase 4 rewrite. The old version argued
       founder pricing as a discount — a rational case that competes poorly
       against "I'll just use the free tier." The real argument is
       continuity of your own story: free proves it works, Premium is how
       you keep the whole thing instead of a rolling 90-day window. Every
       factual claim below was verified against the real, enforced
       implementation before shipping — see the audit report — not just
       copied from the old copy:
         - 90-day free history: src/utils/historyGate.js (FREE_HISTORY_DAYS
           = 90), actually enforced in useSignLogs.js / useJournalEntries.js
         - 500-member cap: src/lib/founderCount.ts (FOUNDER_CAP = 500),
           hard-enforced server-side in api/checkout.ts (fails closed, does
           not let a 501st person through even if Stripe is unreachable)
         - Founder rate permanence: fixed Stripe Price objects
           (price_1U40OR...), not price_data rebuilt per checkout — nothing
           in the codebase migrates an existing subscription to a new price
       The live counter previously existed only on /founders — added here
       too (same /api/founder-count endpoint, not duplicated logic) since
       the rewritten copy makes a specific numeric claim ("the first 500")
       that needs a real number backing it, not just asserted text. -->
  <section class="pricing" id="pricing">
    <div class="container">
      <div class="section-header">
        <span class="section-label">Founding Membership</span>
        <h2 class="section-title">Get in at the beginning — <em>and stay there.</em></h2>
        <p class="section-sub">
          Whisp is new. So is this offer. The first 500 members lock in Premium at half the regular price,
          for as long as they stay — not an intro rate that quietly climbs, not a trial.
          This is what it costs a founding member. Permanently.
        </p>
        <p class="section-sub" style="margin-top:10px;">
          Free shows you it works. Premium is how you keep the whole story — not just the last 90 days of it.
        </p>
        <div class="counter-pill" id="counter-pill-home" data-state="open">
          <span><strong id="counter-num-home">500</strong> of 500 founding spots remain</span>
        </div>
      </div>

      <div class="pricing-grid">
        <div class="pricing-card">
          <div class="pricing-tier">Free</div>
          <div class="pricing-price">
            <span class="price-amount">$0</span>
            <span class="price-period">forever</span>
          </div>
          <ul class="pricing-features">
            <li>✓ Unlimited sign & dream logging</li>
            <li>✓ Symbol library (universal meanings)</li>
            <li>✓ Celestial context</li>
            <li>✓ Basic pattern tracking</li>
