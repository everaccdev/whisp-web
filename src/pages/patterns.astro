---
export const prerender = false;

import MinimalLayout from '../layouts/MinimalLayout.astro';
import { CAMPAIGN_SYMBOLS } from '../lib/recallConfig';

const symbolParam = Astro.url.searchParams.get('symbol');
const variantParam = Astro.url.searchParams.get('variant');
const campaignSymbol = symbolParam && CAMPAIGN_SYMBOLS[symbolParam] ? { key: symbolParam, ...CAMPAIGN_SYMBOLS[symbolParam] } : null;

const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY as string | undefined;
---

<MinimalLayout
  title="Your Pattern Map · Whisp"
  description="Tell Whisp a few things you've noticed over time — a number, an animal, a dream — and see the real thread between them, free."
  ogUrl="https://getwhisp.app/patterns"
>

<section class="pm-page">
  <div class="pm-bg">
    <div class="nebula-blob nebula-blob--a"></div>
    <div class="nebula-blob nebula-blob--b"></div>
    <div class="starfield" id="starfield"></div>
  </div>

  <div class="pm-shell">
    <button type="button" id="back-btn" class="back-btn" hidden aria-label="Back">←</button>

    <!-- Persistent canvas — visible from the first question onward. Stars
         land at their FINAL position the instant an entry is finalized
         (computeEntryPlacement, resolved from the entry's own dominant
         theme) and never move again — same component/positions used here
         and on the final Pattern Map below. -->
    <div id="capture-canvas-wrap" class="canvas-wrap" hidden>
      <div id="capture-constellation" class="constellation-wrap"></div>
    </div>
    <p id="micro-payoff" class="micro-payoff" hidden></p>
    <p id="threshold-line" class="threshold-line" hidden>There's a shape here.</p>

    <!-- ═══ INTRO ═══ -->
    <div class="pm-step" data-step="intro">
      <div class="intro-wordmark">✦ whisp</div>
      <h1 class="intro-headline">You've been noticing things for years.</h1>
      <p class="intro-sub">Most of them you never wrote down.</p>

      <!-- Each button calls handleCategory(category) directly — the exact
           same function the category-grid buttons use — so tapping one
           skips the category-select step entirely and lands on that
           category's specific-select/capture screen, with this tap already
           counted toward entry 1. Begin below still opens the full
           category grid, unchanged. -->
      <div class="intro-examples" id="intro-examples">
        <button type="button" class="intro-example" data-category="number"><span class="intro-example-glyph">#</span> A number that keeps showing up.</button>
        <button type="button" class="intro-example" data-category="dream"><span class="intro-example-glyph">☾</span> A dream you've never quite let go of.</button>
        <button type="button" class="intro-example" data-category="animal"><span class="intro-example-glyph">⋀</span> An animal that seems to find you.</button>
      </div>

      <p class="intro-sub">Show Whisp what comes to mind. Watch the thread form between them.</p>
      <p class="intro-rule">One thing is a moment. Two is a pair. Three is where a shape begins.</p>
      <button type="button" class="cta-btn" id="begin-btn">Begin ✦</button>
    </div>

    <!-- ═══ CATEGORY (repeats per entry) ═══ -->
    <div class="pm-step" data-step="category" hidden>
      <h2 class="q-title" id="category-title">What's been showing up for you?</h2>
      <div class="q-options" id="category-options"></div>
      <p class="nudge" id="nudge" hidden>Many people notice a repeating number, a bird that keeps appearing, or a dream that stayed.</p>
      <button type="button" class="done-btn" id="done-btn" hidden>Reveal my map ✦</button>
      <p class="add-more-hint" id="add-more-hint" hidden>Add more to sharpen it, or reveal it now.</p>
    </div>

    <!-- ═══ SPECIFIC — tap list (number/animal) ═══ -->
    <div class="pm-step" data-step="specific-tap" hidden>
      <h2 class="q-title">Which one?</h2>
      <div class="q-options" id="specific-options"></div>
    </div>

    <!-- ═══ SPECIFIC — free text (dream/object/word/other/Another) ═══ -->
    <div class="pm-step" data-step="specific-text" hidden>
      <h2 class="q-title" id="specific-text-title">What was it?</h2>
      <input type="text" id="specific-text-input" class="q-input" maxlength="120" placeholder="Type it here" />
      <button type="button" class="cta-btn" id="specific-text-continue">Continue</button>
    </div>

    <!-- ═══ DETAIL (era + optional context, 1-tap collapse) ═══ -->
    <div class="pm-step" data-step="detail" hidden>
      <h2 class="q-title">Roughly when — and what was going on?</h2>
      <p class="q-note">Both optional. Tap Continue any time.</p>
      <div class="chip-row" id="era-options">
        <button type="button" class="chip" data-value="recently">Recently</button>
        <button type="button" class="chip" data-value="few_months">A few months ago</button>
        <button type="button" class="chip" data-value="about_year">About a year ago</button>
        <button type="button" class="chip" data-value="years_ago">Years ago</button>
        <button type="button" class="chip" data-value="keeps_happening">It keeps happening</button>
        <button type="button" class="chip" data-value="dont_remember">I don't remember</button>
      </div>
      <input type="text" id="context-input" class="q-input detail-input" maxlength="200" placeholder="What was going on then? (optional)" />
      <button type="button" class="done-btn" id="detail-continue">Continue</button>
    </div>

    <!-- ═══ PATTERN MAP ═══ -->
    <div class="pm-step" data-step="pattern-map" hidden>
      <div id="constellation-wrap" class="constellation-wrap"></div>
      <h2 class="pm-title" id="pm-title">&nbsp;</h2>
      <div id="pm-reveal-body" class="pm-reveal-body">
        <p class="pm-core-story" id="pm-core-story"></p>

        <div class="pm-divider"></div>

        <p class="pm-domain-prompt" id="pm-domain-prompt"></p>
        <div class="pm-domain-grid" id="pm-domain-grid"></div>
        <div class="pm-domain-reading" id="pm-domain-reading" hidden>
          <p class="pm-domain-reading-label" id="pm-domain-reading-label"></p>
          <p class="pm-domain-reading-text" id="pm-domain-reading-text"></p>
        </div>

        <div class="pm-framing" id="pm-framing"></div>
        <p class="pm-gap-line" id="pm-gap-line"></p>

        <button type="button" class="cta-btn" id="pm-continue">See My Full Reading ✦</button>
      </div>
    </div>

    <!-- ═══ EMAIL GATE ═══ -->
    <div class="pm-step" data-step="gate" hidden>
      <h2 class="q-title">Your full reading is ready.</h2>
      <p class="q-note">Where should we send it?</p>
      <form id="gate-form">
        <input type="text" id="gate-name" class="q-input" placeholder="Your name" autocomplete="name" required maxlength="80" />
        <input type="email" id="gate-email" class="q-input" placeholder="your@email.com" autocomplete="email" required maxlength="200" />
        {turnstileSiteKey && (
          <div class="cf-turnstile" data-sitekey={turnstileSiteKey} data-theme="dark"></div>
        )}
        <button type="submit" class="cta-btn" id="gate-submit">Send My Reading ✦</button>
        <p class="fine">
          We'll email you the reading and occasional notes from Whisp. Unsubscribe any time —
          see our <a href="/privacy">privacy policy</a>.
        </p>
        <p id="gate-error" class="form-error" hidden></p>
      </form>
    </div>

    <!-- ═══ LOADING ═══ -->
    <div class="pm-step" data-step="loading" hidden>
      <div class="loading-spinner"></div>
      <p class="loading-text" id="loading-text">Finding the thread…</p>
    </div>
  </div>

  <p class="footer-mark">getwhisp.app</p>
</section>

{turnstileSiteKey && (
  <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
)}

<script is:inline define:vars={{ campaignSymbolJson: campaignSymbol ? JSON.stringify(campaignSymbol) : null, symbolParam, variantParam }}>
  window.__PM_CAMPAIGN__ = campaignSymbolJson ? JSON.parse(campaignSymbolJson) : null;
  window.__PM_PARAMS__ = { symbol: symbolParam || null, variant: variantParam || null };
</script>

<!-- Starfield: generated once on load, not per-render, so it never
     reshuffles. Twinkle animation is skipped entirely under
     prefers-reduced-motion — stars render at a fixed, slightly varied
     opacity instead of animating. -->
<script is:inline>
  (function () {
    var field = document.getElementById('starfield');
    if (!field) return;
    var reduceMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var COUNT = 70;
    var frag = document.createDocumentFragment();
    for (var i = 0; i < COUNT; i++) {
      var star = document.createElement('div');
      star.className = 'star';
      var size = (Math.random() * 1.6 + 0.6).toFixed(2);
      star.style.left = (Math.random() * 100).toFixed(2) + '%';
      star.style.top = (Math.random() * 100).toFixed(2) + '%';
      star.style.width = size + 'px';
      star.style.height = size + 'px';
      if (reduceMotion) {
        star.style.opacity = (Math.random() * 0.35 + 0.25).toFixed(2);
      } else {
        star.style.animationDuration = (Math.random() * 3.5 + 2.5).toFixed(2) + 's';
        star.style.animationDelay = (Math.random() * 5).toFixed(2) + 's';
      }
      frag.appendChild(star);
    }
    field.appendChild(frag);
  })();
</script>

<script>
  import {
    ENTRY_CATEGORIES, NUMBER_OPTIONS, ANIMAL_OPTIONS,
    MIN_ENTRIES, MAX_ENTRIES, DONE_AVAILABLE_FROM, LIFE_DOMAINS,
  } from '../lib/recallConfig';
  import { computeEntryPlacement, themeCacheKeyForSymbol } from '../lib/themeTaxonomy';
  import { glyphForOption, isTypographicNumber } from '../lib/patternMapGlyphs';

  const GET_SYMBOL_TEASER_URL = 'https://us-central1-life-signs-be094.cloudfunctions.net/getSymbolTeaser';
  const ENTRY_PROMPTS = [
    'What’s been showing up for you?',
    'What else have you noticed?',
    'One more — anything else come to mind?',
  ];
  const entryPrompt = (n: number) => ENTRY_PROMPTS[n] || 'Add another';

  const campaign = (window as any).__PM_CAMPAIGN__ as { symbolName: string; category: string } | null;
  const urlParams = (window as any).__PM_PARAMS__ as { symbol: string | null; variant: string | null };
  const posthog = () => (window as any).posthog;
  const reduceMotion = () => window.matchMedia?.('(prefers-reduced-motion: reduce)').matches;

  interface Entry {
    category: string; symbolName: string | null; era: string | null; context: string;
    angleDeg: number; radiusFactor: number; dominantTheme: string | null;
  }
  const emptyDraft = () => ({ category: null as any, symbolName: null as string | null, era: null as string | null, context: '' });

  let entries: Entry[] = [];
  let draft = emptyDraft();
  let story: any = null;
  let themeIds: string[] = [];
  let justCrossedThreshold = false;
  let microPayoffTimer: any = null;

  let utm: any = null;
  try { utm = JSON.parse(localStorage.getItem('whisp_utm') || 'null'); } catch (e) {}

  const els = { backBtn: document.getElementById('back-btn') as HTMLButtonElement };
  const ALL_SCREENS = ['intro', 'category', 'specific-tap', 'specific-text', 'detail', 'pattern-map', 'gate', 'loading'];

  function showScreen(name: string) {
    ALL_SCREENS.forEach((s) => {
      const el = document.querySelector(`[data-step="${s}"]`) as HTMLElement | null;
      if (el) el.hidden = s !== name;
    });
    const capturing = ['category', 'specific-tap', 'specific-text', 'detail'].includes(name);
    (document.getElementById('capture-canvas-wrap') as HTMLElement).hidden = !capturing;
    if (capturing) renderCaptureConstellation();
    if (!capturing || name !== 'category') {
      (document.getElementById('threshold-line') as HTMLElement).hidden = true;
    }
    els.backBtn.hidden = name === 'intro' || name === 'loading';
  }

  function escapeHtml(s: string) {
    return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  }

  // ── Constellation (shared render, capture canvas + final Pattern Map) ─────
  // Entries carry their own FIXED angleDeg/radiusFactor — this function only
  // ever places nodes at those coordinates, never recomputes layout. Edges
  // are consecutive-pairs within same-dominantTheme groups (not a full
  // mesh), shown only once entries.length >= MIN_ENTRIES.
  function buildConstellationHtml(ents: Entry[], showEdges: boolean, editable: boolean) {
    const BOX = 100, CENTER = 50, R = 34;
    const polar = (deg: number, radius: number) => {
      const rad = (deg - 90) * (Math.PI / 180);
      return { x: CENTER + radius * Math.cos(rad), y: CENTER + radius * Math.sin(rad) };
    };
    const positions = ents.map(e => polar(e.angleDeg, R * e.radiusFactor));

    const edges: { from: number; to: number }[] = [];
    if (showEdges) {
      const byTheme: Record<string, number[]> = {};
      ents.forEach((e, i) => {
        if (!e.dominantTheme) return;
        (byTheme[e.dominantTheme] ||= []).push(i);
      });
      Object.values(byTheme).forEach((idxs) => {
        for (let i = 0; i < idxs.length - 1; i++) edges.push({ from: idxs[i], to: idxs[i + 1] });
      });
    }

    let svg = `<svg viewBox="0 0 ${BOX} ${BOX}" class="constellation-svg">`;
    svg += `<circle cx="${CENTER}" cy="${CENTER}" r="${R}" fill="none" stroke="rgba(255,255,255,0.08)" stroke-width="0.4" stroke-dasharray="1.5,2" />`;
    positions.forEach((p) => {
      svg += `<line x1="${CENTER}" y1="${CENTER}" x2="${p.x}" y2="${p.y}" stroke="rgba(255,255,255,0.06)" stroke-width="0.35" />`;
    });
    edges.forEach((edge) => {
      const p1 = positions[edge.from], p2 = positions[edge.to];
      if (!p1 || !p2) return;
      svg += `<line x1="${p1.x}" y1="${p1.y}" x2="${p2.x}" y2="${p2.y}" stroke="rgba(206,166,54,0.6)" stroke-width="0.8" />`;
    });
    svg += `</svg>`;

    let nodesHtml = `<div class="constellation-center"><span>✦</span></div>`;
    positions.forEach((p, i) => {
      const e = ents[i];
      const isNumber = isTypographicNumber(e.category);
      const glyph = isNumber ? null : glyphForOption(e.category, e.symbolName);
      const inner = isNumber
        ? `<span class="constellation-node-numeral">${escapeHtml(e.symbolName || '')}</span>`
        : glyph
          ? `<img src="${glyph}" class="constellation-node-img" alt="" />`
          : `<span>✧</span>`;
      const tag = editable ? 'button' : 'div';
      const attrs = editable ? `type="button" data-remove-idx="${i}"` : '';
      nodesHtml += `<${tag} ${attrs} class="constellation-node" style="left:${p.x}%; top:${p.y}%;">
        <div class="constellation-node-circle">${inner}</div>
        <div class="constellation-node-label">${escapeHtml(e.symbolName || '')}</div>
      </${tag}>`;
    });

    return `<div class="constellation-inner">${svg}${nodesHtml}</div>`;
  }

  function renderCaptureConstellation() {
    const wrap = document.getElementById('capture-constellation') as HTMLDivElement;
    wrap.innerHTML = buildConstellationHtml(entries, entries.length >= MIN_ENTRIES, true);
    wrap.querySelectorAll<HTMLButtonElement>('[data-remove-idx]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const idx = Number(btn.dataset.removeIdx);
        const entry = entries[idx];
        if (!confirm(`Remove "${entry.symbolName}" from your map?`)) return;
        entries = entries.filter((_, i) => i !== idx);
        if (entries.length < MIN_ENTRIES) justCrossedThreshold = false;
        renderCaptureConstellation();
        renderCategoryScreen();
      });
    });
  }

  function renderCategoryScreen() {
    (document.getElementById('category-title') as HTMLElement).textContent =
      entries.length < MIN_ENTRIES ? entryPrompt(entries.length) : 'Add another';
    const optsWrap = document.getElementById('category-options') as HTMLDivElement;
    optsWrap.innerHTML = '';
    ENTRY_CATEGORIES.forEach((c) => {
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'opt-btn';
      const glyph = isTypographicNumber(c.key) ? null : glyphForOption(c.key);
      btn.innerHTML = (glyph ? `<img src="${glyph}" class="opt-glyph" alt="" />` : '') + `<span>${escapeHtml(c.label)}</span>`;
      btn.addEventListener('click', () => handleCategory(c.key));
      optsWrap.appendChild(btn);
    });

    (document.getElementById('nudge') as HTMLElement).hidden = entries.length !== 0;
    const atThreshold = entries.length >= DONE_AVAILABLE_FROM;
    (document.getElementById('done-btn') as HTMLElement).hidden = !atThreshold;
    (document.getElementById('add-more-hint') as HTMLElement).hidden = !atThreshold;
    const thresholdEl = document.getElementById('threshold-line') as HTMLElement;
    thresholdEl.hidden = !justCrossedThreshold;
  }

  document.getElementById('begin-btn')?.addEventListener('click', () => {
    posthog()?.capture('recall_started', { host: 'web', symbol: urlParams.symbol, variant: urlParams.variant });
    if (campaign) {
      draft.category = campaign.category;
      draft.symbolName = campaign.symbolName;
      showScreen('detail');
    } else {
      showScreen('category');
      renderCategoryScreen();
    }
  });

  document.getElementById('intro-examples')?.querySelectorAll<HTMLButtonElement>('.intro-example').forEach((btn) => {
    btn.addEventListener('click', () => {
      posthog()?.capture('recall_started', { host: 'web', symbol: urlParams.symbol, variant: urlParams.variant });
      handleCategory(btn.dataset.category || '');
    });
  });

  function handleCategory(key: string) {
    draft.category = key;
    if (key === 'number' || key === 'animal') {
      buildSpecificTapList();
      showScreen('specific-tap');
    } else {
      (document.getElementById('specific-text-title') as HTMLElement).textContent =
        key === 'dream' ? 'What do you remember most?' : 'What was it?';
      showScreen('specific-text');
    }
  }

  function buildSpecificTapList() {
    const wrap = document.getElementById('specific-options') as HTMLDivElement;
    wrap.innerHTML = '';
    const options = draft.category === 'number' ? NUMBER_OPTIONS : ANIMAL_OPTIONS;
    options.forEach((opt) => {
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'opt-btn';
      const glyph = opt !== 'Another' ? glyphForOption(draft.category, opt) : null;
      btn.innerHTML = (glyph ? `<img src="${glyph}" class="opt-glyph" alt="" />` : '') + `<span>${escapeHtml(opt)}</span>`;
      btn.addEventListener('click', () => {
        if (opt === 'Another') {
          (document.getElementById('specific-text-title') as HTMLElement).textContent = 'What was it?';
          showScreen('specific-text');
          return;
        }
        draft.symbolName = opt;
        showScreen('detail');
      });
      wrap.appendChild(btn);
    });
  }

  const specificTextInput = document.getElementById('specific-text-input') as HTMLInputElement;
  document.getElementById('specific-text-continue')?.addEventListener('click', () => {
    const val = specificTextInput.value.trim();
    if (!val) return;
    draft.symbolName = val;
    specificTextInput.value = '';
    showScreen('detail');
  });

  let eraSelection: string | null = null;
  document.getElementById('era-options')?.querySelectorAll<HTMLButtonElement>('.chip').forEach((btn) => {
    btn.addEventListener('click', () => {
      eraSelection = btn.dataset.value || null;
      document.querySelectorAll('#era-options .chip').forEach(c => c.classList.remove('chip-active'));
      btn.classList.add('chip-active');
    });
  });

  const contextInput = document.getElementById('context-input') as HTMLInputElement;

  // Zero-generation micro-payoff: a plain cache read via the public
  // getSymbolTeaser function (read-only, never generates on a miss — see
  // functions/index.js). Silent on a miss; never fabricated.
  async function fetchCachedTeaser(symbolName: string): Promise<string | null> {
    try {
      const key = themeCacheKeyForSymbol(symbolName);
      const res = await fetch(`${GET_SYMBOL_TEASER_URL}?key=${encodeURIComponent(key)}`, { signal: AbortSignal.timeout(4000) });
      const data = await res.json();
      return data?.found ? data.meaning : null;
    } catch (e) {
      return null;
    }
  }

  async function finalizeEntry() {
    const symbolName = draft.symbolName;
    const category = draft.category;
    const era = eraSelection || 'dont_remember';
    const context = contextInput.value.trim();

    const cachedLine = await fetchCachedTeaser(symbolName || '');
    const placement = computeEntryPlacement(symbolName, cachedLine, `${symbolName}_${entries.length}`);
    const finished: Entry = {
      category, symbolName, era, context,
      angleDeg: placement.angleDeg, radiusFactor: placement.radiusFactor, dominantTheme: placement.dominantTheme,
    };
    entries = [...entries, finished];
    posthog()?.capture('recall_entry_added', { entry_index: entries.length, category });

    const payoffEl = document.getElementById('micro-payoff') as HTMLElement;
    clearTimeout(microPayoffTimer);
    if (cachedLine) {
      payoffEl.innerHTML = `✦ <strong>${escapeHtml(symbolName || '')}</strong> — ${escapeHtml(cachedLine)}`;
      payoffEl.hidden = false;
      microPayoffTimer = setTimeout(() => { payoffEl.hidden = true; }, 6000);
    } else {
      payoffEl.hidden = true;
    }

    if (entries.length === MIN_ENTRIES) justCrossedThreshold = true;

    draft = emptyDraft();
    eraSelection = null;
    contextInput.value = '';

    if (entries.length >= MAX_ENTRIES) {
      goToPatternMap();
    } else {
      showScreen('category');
      renderCategoryScreen();
    }
  }
  document.getElementById('detail-continue')?.addEventListener('click', finalizeEntry);

  document.getElementById('done-btn')?.addEventListener('click', () => {
    posthog()?.capture('recall_completed', { entry_count: entries.length });
    goToPatternMap();
  });

  els.backBtn.addEventListener('click', () => {
    const current = ALL_SCREENS.find((s) => {
      const el = document.querySelector(`[data-step="${s}"]`) as HTMLElement | null;
      return el && !el.hidden;
    });
    if (current === 'detail') {
      showScreen(draft.category === 'number' || draft.category === 'animal' ? 'specific-tap' : 'specific-text');
      return;
    }
    if (current === 'specific-tap' || current === 'specific-text') { showScreen('category'); renderCategoryScreen(); return; }
    if (current === 'category') {
      if (entries.length > 0) posthog()?.capture('recall_abandoned', { entry_count: entries.length });
      showScreen('intro');
      return;
    }
    showScreen('intro');
  });

  // ── Pattern Map (reveal choreography) ──────────────────────────────────────
  // The constellation is already fully built (fixed positions, edges
  // included) — what's new on arrival is the story. A brief pause + fade-in
  // makes that read as something resolving, not an instant content swap.
  // Respects prefers-reduced-motion by skipping the delay/transition
  // entirely rather than degrading it.
  async function goToPatternMap() {
    showScreen('loading');
    (document.getElementById('loading-text') as HTMLElement).textContent = 'Finding the thread…';

    try {
      const res = await fetch('/api/theme-triad-story', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ entries: entries.map(e => ({ symbolName: e.symbolName })) }),
      });
      const data = await res.json();
      story = data?.story || null;
      themeIds = data?.themeIds || [];
      posthog()?.capture('pattern_map_viewed', { triad_key: data?.cacheKey || 'none', cache_hit: !!data?.cacheHit });
    } catch (e) {
      story = null;
    }

    const constellationWrap = document.getElementById('constellation-wrap') as HTMLDivElement;
    constellationWrap.innerHTML = buildConstellationHtml(entries, true, false);

    const titleEl = document.getElementById('pm-title') as HTMLElement;
    const coreStoryEl = document.getElementById('pm-core-story') as HTMLElement;
    const domainPromptEl = document.getElementById('pm-domain-prompt') as HTMLElement;
    const domainGridEl = document.getElementById('pm-domain-grid') as HTMLDivElement;
    const framingEl = document.getElementById('pm-framing') as HTMLElement;
    const gapLineEl = document.getElementById('pm-gap-line') as HTMLElement;
    const revealBody = document.getElementById('pm-reveal-body') as HTMLElement;

    titleEl.textContent = '';
    revealBody.classList.remove('revealed');
    titleEl.classList.remove('revealed');

    if (!story) {
      titleEl.textContent = "A pattern hasn't taken shape yet";
      coreStoryEl.textContent = 'What you shared is real, but Whisp needs a little more of a shared thread to weave a story from it.';
      domainPromptEl.hidden = true;
      domainGridEl.hidden = true;
    } else {
      titleEl.textContent = story.title;
      coreStoryEl.textContent = story.coreStory;
      domainPromptEl.hidden = false;
      domainPromptEl.textContent = story.domainPrompt;
      domainGridEl.hidden = false;
      domainGridEl.innerHTML = '';
      LIFE_DOMAINS.forEach((domain) => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'domain-btn';
        btn.textContent = domain;
        btn.addEventListener('click', () => {
          domainGridEl.querySelectorAll('.domain-btn').forEach(b => b.classList.remove('domain-btn-active'));
          btn.classList.add('domain-btn-active');
          posthog()?.capture('domain_selected', { domain });
          const readingWrap = document.getElementById('pm-domain-reading') as HTMLDivElement;
          const readingLabel = document.getElementById('pm-domain-reading-label') as HTMLElement;
          const readingText = document.getElementById('pm-domain-reading-text') as HTMLElement;
          const text = story.domainReadings?.[domain];
          if (text) {
            readingLabel.textContent = domain.toUpperCase();
            readingText.textContent = text;
            readingWrap.hidden = false;
            (window as any).__PM_SELECTED_DOMAIN__ = domain;
          }
        });
        domainGridEl.appendChild(btn);
      });
      framingEl.innerHTML = '';
      [story.strengthFraming, "This is drawn from what you remembered. Whisp gets sharper as you log things as they happen."].forEach((t) => {
        const p = document.createElement('p');
        p.className = 'pm-framing-line';
        p.textContent = t;
        framingEl.appendChild(p);
      });
    }

    gapLineEl.textContent = `This is ${entries.length} thing${entries.length === 1 ? '' : 's'} you remembered. Whisp does this continuously with everything you notice.`;

    showScreen('pattern-map');

    const skipDelay = reduceMotion();
    setTimeout(() => { titleEl.classList.add('revealed'); }, skipDelay ? 0 : 450);
    setTimeout(() => { revealBody.classList.add('revealed'); }, skipDelay ? 0 : 650);
  }

  document.getElementById('pm-continue')?.addEventListener('click', () => {
    posthog()?.capture('email_gate_viewed');
    showScreen('gate');
  });

  // ── Gate + submit ──────────────────────────────────────────────────────
  const gateForm = document.getElementById('gate-form') as HTMLFormElement;
  const gateError = document.getElementById('gate-error') as HTMLParagraphElement;
  const LOADING_COPY = ['Reading your signs…', 'Weaving the threads…', 'Almost there…'];

  gateForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    gateError.hidden = true;

    const name = (document.getElementById('gate-name') as HTMLInputElement).value.trim();
    const email = (document.getElementById('gate-email') as HTMLInputElement).value.trim();
    const turnstileField = gateForm.querySelector('[name="cf-turnstile-response"]') as HTMLInputElement | null;
    const selectedDomain = (window as any).__PM_SELECTED_DOMAIN__ || null;

    posthog()?.capture('lead_captured');
    showScreen('loading');
    let copyIdx = 0;
    const loadingTextEl = document.getElementById('loading-text') as HTMLElement;
    loadingTextEl.textContent = LOADING_COPY[0];
    const timer = setInterval(() => {
      copyIdx = Math.min(copyIdx + 1, LOADING_COPY.length - 1);
      loadingTextEl.textContent = LOADING_COPY[copyIdx];
    }, 2500);

    try {
      const res = await fetch('/api/lead-reading', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          name, email,
          turnstileToken: turnstileField?.value || '',
          recallEntries: entries.map(e => ({ symbolName: e.symbolName, category: e.category, era: e.era, context: e.context })),
          selectedDomain,
          triadKey: themeIds.length ? [...themeIds].sort().join('__') : null,
          utm,
          campaign: { symbol: urlParams.symbol, variant: urlParams.variant },
        }),
      });
      const data = await res.json();
      clearInterval(timer);

      if (res.ok && data.readingId) {
        window.location.href = `/r/${data.readingId}`;
        return;
      }
      throw new Error(data.error || 'Something went wrong. Please try again.');
    } catch (err: any) {
      clearInterval(timer);
      showScreen('gate');
      gateError.textContent = err.message;
      gateError.hidden = false;
    }
  });

  showScreen('intro');
</script>

