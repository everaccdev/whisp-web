---
// This project defaults to static prerendering (astro.config.mjs:
// output: 'hybrid'). Without this, the founder count fetched below would
// be baked in at BUILD time and never update again — the whole point of a
// "live" counter — so this page must opt out, same as founders/success.astro
// and the r/[id] share pages already do.
export const prerender = false;

import MinimalLayout from '../layouts/MinimalLayout.astro';
import { getFounderCount, FOUNDER_CAP, FOUNDER_REVEAL_THRESHOLD } from '../lib/founderCount';

// Server-rendered initial value so the page never flashes "0 of 500" before
// JS loads — the client script (below) re-fetches on load to stay current
// with the 5-minute cache, but this gives a correct number on first paint.
const founderStatus = await getFounderCount(import.meta.env.STRIPE_SECRET_KEY as string);
const initialCount = founderStatus?.count ?? null;
const initialRemaining = founderStatus?.remaining ?? null;
const initialCapReached = founderStatus?.capReached ?? false;
const initialUnavailable = founderStatus === null;
// Below the threshold, showing the real (low) count publicly reads as
// reverse social proof — "0 of 500 sold" tells every visitor nobody else
// has bought yet. See FOUNDER_REVEAL_THRESHOLD in src/lib/founderCount.ts.
const initialShowNumber = !initialUnavailable && !initialCapReached
  && initialCount !== null && initialCount >= FOUNDER_REVEAL_THRESHOLD;
---

<MinimalLayout
  title="Founders Access · Whisp"
  description="Lock in premium access at the founders price — $39.97/year, capped at 500 members — before Whisp goes wide."
  ogUrl="https://getwhisp.app/founders"
>

<section class="founders-page">

  <!-- ═══ 1. HERO ═══ -->
  <div class="hero">
    <div class="hero-bg"></div>
    <div class="hero-wordmark">✦ whisp</div>
    <div class="hero-content">
      <p class="eyebrow">FOUNDERS ACCESS</p>
      <h1 class="headline">
        Be among the first<br/>
        <em>to see the whole picture.</em>
      </h1>
      <p class="sub">
        Every reflection, your full history, dreams explored in depth, celestial and
        sacred context &mdash; and everything we build next, at the founders rate.
      </p>
      <div class="hero-price">
        <div class="hero-price-compare">
          <span class="hero-price-was">$95.88/yr standard</span>
          <span class="save-badge save-badge--hero">SAVE 58%</span>
        </div>
        <div class="hero-price-now">
          <span class="hero-price-amount">$39.97</span>
          <span class="hero-price-note">/year, founders rate</span>
        </div>
      </div>
      <!-- Checkout lives here as well as in the offer card below: a
           visitor convinced by the hero shouldn't have to scroll to a
           second screen and take a second action to act on it. Both forms
           post through the SAME startCheckout() path (see the script) —
           this is a second entry point, not a second checkout. Plan
           follows the toggle below, which defaults to annual; the link
           underneath is there so monthly isn't hidden from anyone who
           wants it. -->
      <form id="hero-checkout-form" class="hero-checkout">
        <input
          type="email"
          id="hero-email-input"
          class="hero-email"
          placeholder="your@email.com"
          autocomplete="email"
          aria-label="Email address"
          required
        />
        <button type="submit" id="hero-checkout-btn" class="btn-hero-cta">
          <span id="hero-btn-text">Get Founders Access ✦</span>
          <span id="hero-btn-loading" style="display:none;">Taking you to checkout…</span>
        </button>
      </form>
      <p class="hero-checkout-fine">
        Secure checkout via Stripe &middot; cancel anytime &middot;
        <a href="#offer">see monthly pricing &darr;</a>
      </p>
      <div class="hero-counter-text" id="counter-pill-hero" data-state={initialCapReached ? 'capped' : 'open'}>
        {initialUnavailable ? (
          <span>Founders access is limited to {FOUNDER_CAP} members</span>
        ) : initialCapReached ? (
          <span>All 500 founding spots are taken</span>
        ) : initialShowNumber ? (
          <span><strong id="counter-num-hero">{initialRemaining}</strong> of {FOUNDER_CAP} founding spots remain</span>
        ) : (
