      </figure>
      <figure class="proof-shot proof-shot--offset">
        <img src="/store-3-weave.jpg" alt="Whisp App Store listing: Receive your weekly Weave — a written reflection for the week with chakra and golden-ratio resonance" loading="lazy" width="620" height="1341" />
      </figure>
    </div>
