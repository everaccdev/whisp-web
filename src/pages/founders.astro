    </div>
    <a href="#offer" class="btn-hero-cta">Get Founders Access ✦</a>
  </div>

  <p class="footer-mark">getwhisp.app</p>

</section>

<script>
  let selectedPlan = 'annual';

  const btnMonthly = document.getElementById('btn-monthly') as HTMLButtonElement;
  const btnAnnual  = document.getElementById('btn-annual')  as HTMLButtonElement;
  const priceEl    = document.getElementById('price-display') as HTMLSpanElement;
  const noteEl     = document.getElementById('price-note')   as HTMLSpanElement;
  const wasEl      = document.getElementById('price-was')    as HTMLSpanElement;
  const compareEl  = document.getElementById('price-compare') as HTMLParagraphElement;

  const PRICE_COPY = {
    annual:  { price: '$39.97', note: '/year · cancel anytime',  was: '$95.88/yr standard', compare: 'You save $55.91/yr — roughly 58% less than standard, locked in for as long as you stay subscribed.' },
    monthly: { price: '$3.99',  note: '/month · cancel anytime', was: '$7.99/mo standard',   compare: 'You save $4.00/mo — roughly 50% less than standard, locked in for as long as you stay subscribed.' },
  };

  function selectPlan(plan: 'annual' | 'monthly') {
    selectedPlan = plan;
    btnAnnual.classList.toggle('active', plan === 'annual');
    btnMonthly.classList.toggle('active', plan === 'monthly');
    priceEl.textContent = PRICE_COPY[plan].price;
    noteEl.textContent = PRICE_COPY[plan].note;
    wasEl.textContent = PRICE_COPY[plan].was;
    compareEl.textContent = PRICE_COPY[plan].compare;
  }

  btnAnnual.addEventListener('click', () => selectPlan('annual'));
  btnMonthly.addEventListener('click', () => selectPlan('monthly'));

  const form        = document.getElementById('checkout-form') as HTMLFormElement;
  const checkoutBtn = document.getElementById('checkout-btn')  as HTMLButtonElement;
  const btnText     = document.getElementById('btn-text')      as HTMLSpanElement;
  const btnSpin     = document.getElementById('btn-loading')   as HTMLSpanElement;
  const emailInput  = document.getElementById('email-input')   as HTMLInputElement;

  // In-app external-checkout entry point (App Store 3.1.1(a), iOS/US only —
  // see src/services/founderCheckoutService.js in the main app repo) opens
  // this page as https://getwhisp.app/founders?uid=...&email=.... uid rides
  // into Checkout metadata so stripeWebhook attaches the purchase to this
  // exact existing account instead of resolving by email (which could
  // create a second, orphaned account if the billing email differs from
  // the one the app account uses). email just prefills the field so a
  // signed-in user isn't asked to retype something the app already knows.
  const appParams = new URLSearchParams(window.location.search);
  const appUid    = appParams.get('uid') || null;
  const appEmail  = appParams.get('email') || null;
  if (appEmail && emailInput && !emailInput.value) emailInput.value = appEmail;
  if (appUid) {
    (window as any).posthog?.capture('website_founders_opened_from_app');
  }

  // Hero form — a second ENTRY POINT into the same checkout, not a second
  // checkout. Both forms call startCheckout() below so the plan, UTM,
  // in-app uid, cap handling and error paths can never drift apart.
  const heroForm    = document.getElementById('hero-checkout-form') as HTMLFormElement | null;
  const heroBtn     = document.getElementById('hero-checkout-btn')  as HTMLButtonElement | null;
  const heroText    = document.getElementById('hero-btn-text')      as HTMLSpanElement | null;
  const heroSpin    = document.getElementById('hero-btn-loading')   as HTMLSpanElement | null;
  const heroEmail   = document.getElementById('hero-email-input')   as HTMLInputElement | null;

  if (appEmail && heroEmail && !heroEmail.value) heroEmail.value = appEmail;

  async function startCheckout(
    email: string,
    btn: HTMLButtonElement,
    txt: HTMLElement,
    spin: HTMLElement,
    location: string,
  ) {
    btn.disabled = true;
    txt.style.display = 'none';
    spin.style.display = 'inline';

    const restore = () => {
      btn.disabled = false;
      txt.style.display = 'inline';
      spin.style.display = 'none';
    };

    let utm = null;
    try { utm = JSON.parse(localStorage.getItem('whisp_utm') || 'null'); } catch (e) {}

    // `location` distinguishes hero vs offer-card so we can see whether
    // putting checkout in the hero actually converts.
    (window as any).posthog?.capture('website_checkout_started', {
      plan: selectedPlan, from_app: !!appUid, location,
    });

    try {
      const res  = await fetch('/api/checkout', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email, plan: selectedPlan, utm, uid: appUid || undefined }),
      });
      const data = await res.json();
      if (data.url) {
        window.location.href = data.url;
      } else if (data.error === 'cap_reached') {
        alert(data.message || 'Founders access has reached its cap.');
        restore();
        window.location.reload(); // re-fetch so the page reflects the cap
      } else {
        throw new Error(data.error || 'Unknown error');
      }
    } catch (err: any) {
      alert('Something went wrong: ' + err.message);
      restore();
    }
  }

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const email = emailInput.value.trim();
    if (!email) { emailInput.focus(); return; }
    startCheckout(email, checkoutBtn, btnText, btnSpin, 'offer_card');
  });

  if (heroForm && heroBtn && heroText && heroSpin && heroEmail) {
    heroForm.addEventListener('submit', (e) => {
      e.preventDefault();
      const email = heroEmail.value.trim();
      if (!email) { heroEmail.focus(); return; }
      startCheckout(email, heroBtn, heroText, heroSpin, 'hero');
    });
  }

  // Re-fetch the live count on load — the server-rendered number above is
  // correct at request time, but this keeps a page left open in a tab from
  // drifting more than the 5-minute cache window. Always rebuilds the
  // pill's full innerHTML (rather than patching a number in place) since
  // which case applies (capped / real number / neutral "spots open") can
  // change between the server render and this fetch, and each case has a
  // different DOM shape.
  //
  // Keep in sync with FOUNDER_REVEAL_THRESHOLD in src/lib/founderCount.ts
  // — this script can't import a TS module at runtime.
  const FOUNDER_REVEAL_THRESHOLD = 25;
  fetch('/api/founder-count')
    .then(r => r.json())
    .then(data => {
      if (!data.available) return; // Stripe was unreachable — leave the server-rendered value as-is
      const pills = ['hero', 'scarcity', 'final'].map(id => document.getElementById(`counter-pill-${id}`));
      pills.forEach((pill) => {
        if (!pill) return;
        if (data.capReached) {
          pill.dataset.state = 'capped';
          pill.innerHTML = '<span>All 500 founding spots are taken</span>';
        } else if (typeof data.count === 'number' && data.count < FOUNDER_REVEAL_THRESHOLD) {
          pill.dataset.state = 'open';
          pill.innerHTML = '<span>Founding spots open</span>';
        } else {
          pill.dataset.state = 'open';
          pill.innerHTML = `<span><strong>${data.remaining}</strong> of 500 founding spots remain</span>`;
        }
      });
    })
    .catch(() => {}); // silent — server-rendered value stays as the fallback
</script>

</MinimalLayout>

<style>
  .founders-page {
    min-height: 100vh;
    background: linear-gradient(180deg, #07041a 0%, #0e0830 40%, #050212 100%);
    color: #faf8f3;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  /* ── Hero ──────────────────────────────────────────────────────────────── */
  .hero {
    position: relative;
    width: 100%;
    padding: 80px 24px 56px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    overflow: hidden;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse at 50% 0%, rgba(149,117,205,0.25) 0%, transparent 60%),
      radial-gradient(ellipse at 30% 80%, rgba(240,192,64,0.08) 0%, transparent 55%);
  }

  .hero-wordmark {
    font-family: 'Cormorant Garamond', serif;
    font-style: italic;
    font-weight: 300;
    font-size: 22px;
    color: rgba(255,248,235,0.6);
    letter-spacing: 1px;
    margin-bottom: 40px;
    position: relative;
    z-index: 1;
  }

  .hero-content {
    position: relative;
    z-index: 1;
    max-width: 560px;
  }

  .eyebrow {
    font-family: 'Raleway', sans-serif;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 3px;
    color: #9575CD;
    margin: 0 0 20px;
  }

  .headline {
    font-family: 'Cormorant Garamond', serif;
    font-weight: 300;
    font-size: clamp(32px, 8vw, 52px);
    line-height: 1.15;
    color: #faf8f3;
    margin: 0 0 20px;
  }

  .headline em { font-style: italic; color: #F0C040; }

  .sub {
    font-family: 'Raleway', sans-serif;
    font-size: 16px;
    line-height: 1.7;
    color: rgba(255,255,255,0.68);
    max-width: 460px;
    margin: 0 auto 28px;
  }

  .hero-price {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    margin-bottom: 18px;
  }
  .hero-price-compare {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .hero-price-was {
    font-family: 'Raleway', sans-serif;
    font-size: 13px;
    color: rgba(255,255,255,0.4);
    text-decoration: line-through;
    text-decoration-color: rgba(255,255,255,0.3);
  }
  .save-badge--hero {
    font-size: 10px;
  }
  .hero-price-now {
    display: flex;
    align-items: baseline;
    gap: 8px;
  }
  .hero-price-amount {
    font-family: 'Cormorant Garamond', serif;
    font-size: 44px;
    color: #F0C040;
  }
  .hero-price-note {
    font-family: 'Raleway', sans-serif;
    font-size: 13px;
    color: rgba(255,255,255,0.5);
  }

  .counter-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 16px;
    border-radius: 999px;
    background: rgba(240,192,64,0.08);
    border: 0.5px solid rgba(240,192,64,0.3);
    font-family: 'Raleway', sans-serif;
    font-size: 12.5px;
    color: rgba(255,255,255,0.75);
    margin-bottom: 24px;
  }
  .counter-pill strong { color: #F0C040; font-weight: 700; }
  .counter-pill[data-state="capped"] {
