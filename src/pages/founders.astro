---
// This project defaults to static prerendering (astro.config.mjs:
// output: 'hybrid'). Without this, the founder count fetched below would
// be baked in at BUILD time and never update again — the whole point of a
// "live" counter — so this page must opt out, same as founders/success.astro
// and the r/[id] share pages already do.
export const prerender = false;

import MinimalLayout from '../layouts/MinimalLayout.astro';
import { getFounderCount, FOUNDER_CAP } from '../lib/founderCount';

// Server-rendered initial value so the page never flashes "0 of 500" before
// JS loads — the client script (below) re-fetches on load to stay current
// with the 5-minute cache, but this gives a correct number on first paint.
const founderStatus = await getFounderCount(import.meta.env.STRIPE_SECRET_KEY as string);
const initialRemaining = founderStatus?.remaining ?? null;
const initialCapReached = founderStatus?.capReached ?? false;
---

<MinimalLayout
  title="Founders Access · Whisp"
  description="Lock in premium access at the founders price — $39.97/year, capped at 500 members — before Whisp goes wide."
  ogUrl="https://getwhisp.app/founders"
>

<section class="founders-page">

  <!-- ═══ 1. HERO ═══ -->
  <div class="hero">
    <div class="hero-bg"></div>
    <div class="hero-wordmark">✦ whisp</div>
    <div class="hero-content">
      <p class="eyebrow">FOUNDERS ACCESS</p>
      <h1 class="headline">
        Be among the first<br/>
        <em>to hear every sign.</em>
      </h1>
      <p class="sub">
        Lock in full premium — journals, AI reflections, dream archetypes,
        celestial context, and everything we build next — at the founders rate.
      </p>
      <div class="hero-price">
        <div class="hero-price-compare">
          <span class="hero-price-was">$95.88/yr standard</span>
          <span class="save-badge save-badge--hero">SAVE 58%</span>
        </div>
        <div class="hero-price-now">
          <span class="hero-price-amount">$39.97</span>
          <span class="hero-price-note">/year, founders rate</span>
        </div>
      </div>
      <a href="#offer" class="btn-hero-cta">Get Founders Access ✦</a>
      <div class="hero-counter-text" id="counter-pill-hero" data-state={initialCapReached ? 'capped' : 'open'}>
        {initialRemaining !== null ? (
          initialCapReached ? (
            <span>All 500 founding spots are taken</span>
          ) : (
            <span><strong id="counter-num-hero">{initialRemaining}</strong> of {FOUNDER_CAP} founding spots remain</span>
          )
        ) : (
          <span>Founders access is limited to {FOUNDER_CAP} members</span>
        )}
      </div>
    </div>
  </div>

  <!-- ═══ 2. PROOF IT'S REAL ═══ -->
  <div class="proof">
    <p class="proof-note">Whisp is live now on iOS and Android — this isn't a waitlist for something that doesn't exist yet.</p>
    <div class="proof-shots">
      <div class="proof-shot proof-shot--offset">
        <img src="/whisp_appstore_01.png" alt="Whisp sign log" loading="lazy" />
      </div>
      <div class="proof-shot proof-shot--lead">
        <img src="/whisp_appstore_03.png" alt="Whisp AI reflection" loading="lazy" />
      </div>
      <div class="proof-shot proof-shot--offset">
        <img src="/whisp_appstore_05.png" alt="Whisp pattern insights" loading="lazy" />
      </div>
    </div>
    <div class="proof-links">
      <a href="https://apps.apple.com/app/id6777561873" class="store-link">App Store ↗</a>
      <a href="https://play.google.com/store/apps/details?id=com.eyeswidewellness.whisp&pcampaignid=web_founders" class="store-link">Google Play ↗</a>
    </div>
  </div>

  <!-- ═══ 3. WHAT PREMIUM UNLOCKS — outcomes, not features ═══ -->
  <div class="outcomes">
    <p class="section-eyebrow">WHAT CHANGES WITH PREMIUM</p>
    <h2 class="outcomes-heading">One price. Everything unlocked.</h2>
    <div class="outcomes-grid">
      <div class="outcome-card">
        <span class="outcome-mark">✦</span>
        <div><strong>Every sign gets a reading</strong><span>Never rationed to a handful a month.</span></div>
      </div>
      <div class="outcome-card">
        <span class="outcome-mark">✦</span>
        <div><strong>Your whole history stays visible</strong><span>Not just the last 90 days.</span></div>
      </div>
      <div class="outcome-card">
        <span class="outcome-mark">✦</span>
        <div><strong>Notice what's repeating before you would</strong><span>Weekly pattern summaries across signs and dreams.</span></div>
      </div>
      <div class="outcome-card">
        <span class="outcome-mark">✦</span>
        <div><strong>Dreams read in depth</strong><span>Archetypes, recurring symbols, how they echo your waking signs.</span></div>
      </div>
      <div class="outcome-card">
        <span class="outcome-mark">✦</span>
        <div><strong>A picture for what a sign evokes</strong><span>AI-generated imagery, not a stock icon.</span></div>
      </div>
      <div class="outcome-card">
        <span class="outcome-mark">✦</span>
        <div><strong>Celestial &amp; sacred context</strong><span>Moon phase, retrogrades, and scripture that speaks to the moment — if that's part of how you see things.</span></div>
      </div>
      <div class="outcome-card">
        <span class="outcome-mark">✦</span>
        <div><strong>Share a reading with someone you love</strong><span>Gifted readings, no account needed on their end.</span></div>
      </div>
      <div class="outcome-card outcome-card--highlight">
        <span class="outcome-mark">✦</span>
        <div><strong>Everything we ship next</strong><span>Included, not upsold separately — for as long as you're a founder.</span></div>
      </div>
    </div>
  </div>

  <!-- ═══ 4. PRICE — annual first ═══ -->
  <div class="offer-wrap" id="offer">
    <div class="offer-card">
      <p class="offer-eyebrow">✦ FOUNDERS PRICE</p>

      <div class="plan-toggle">
        <button class="plan-btn active" id="btn-annual" data-plan="annual">
          Annual <span class="save-badge">SAVE 58%</span>
        </button>
        <button class="plan-btn" id="btn-monthly" data-plan="monthly">
          Monthly
        </button>
      </div>

      <div class="price-was-row">
        <span class="price-was" id="price-was">$95.88/yr standard</span>
      </div>
      <div class="price-row">
        <span class="price" id="price-display">$39.97</span>
        <span class="price-note" id="price-note">/year · cancel anytime</span>
      </div>
      <p class="price-compare" id="price-compare">You save $55.91/yr — roughly 58% less than standard, locked in for as long as you stay subscribed.</p>
      <p class="offer-includes">Includes everything above — every reading, full history, dream depth, and everything we ship next.</p>

      <form id="checkout-form">
        <input
          type="email"
          id="email-input"
          placeholder="your@email.com"
          autocomplete="email"
          required
        />
        <button type="submit" id="checkout-btn">
          <span id="btn-text">Get Founders Access ✦</span>
          <span id="btn-loading" style="display:none;">Taking you to checkout…</span>
        </button>
      </form>

      <p class="fine">
        Secure checkout via Stripe · Your account is created automatically after payment ·
        You'll receive an email to set your password. The founders rate is locked in for as long as your subscription stays active.
      </p>
    </div>
  </div>

  <!-- ═══ 5. HONEST SCARCITY ═══ -->
  <div class="scarcity">
    <div class="counter-pill counter-pill--large" id="counter-pill-scarcity" data-state={initialCapReached ? 'capped' : 'open'}>
      {initialRemaining !== null ? (
        initialCapReached ? (
          <span>All 500 founding spots are taken</span>
        ) : (
          <span><strong id="counter-num-scarcity">{initialRemaining}</strong> of {FOUNDER_CAP} founding spots remain</span>
        )
      ) : (
        <span>Founders access is limited to {FOUNDER_CAP} members</span>
      )}
    </div>
    <p class="scarcity-note">Once the 500 are gone, standard pricing applies to anyone who joins after — the founders rate doesn't come back.</p>
  </div>

  <!-- ═══ 6. FAQ ═══ -->
  <div class="faq-wrap">
    <p class="section-eyebrow">QUESTIONS</p>
    <div class="faq-list">
      <details class="faq-item">
        <summary class="faq-q">What happens after I pay?</summary>
        <p class="faq-a">Your account is created automatically and premium is active immediately. You'll get an email within a few minutes with a link to set your password — sign in with the same email address and download the app.</p>
      </details>
      <details class="faq-item">
        <summary class="faq-q">Does this work on both iOS and Android?</summary>
        <p class="faq-a">Yes. Whisp is live on both the App Store and Google Play, and premium works identically on either.</p>
      </details>
      <details class="faq-item">
        <summary class="faq-q">What if I already downloaded the free app?</summary>
        <p class="faq-a">Use the same email address at checkout. Premium attaches to your existing account — you won't end up with a duplicate, and everything you've already logged stays exactly where it is.</p>
      </details>
      <details class="faq-item">
        <summary class="faq-q">Can I cancel? What happens to my data?</summary>
        <p class="faq-a">Cancel anytime from the app or your Stripe receipt — no phone call, no retention flow. Your data stays yours: full export is available, and permanent deletion is available on request. Nothing is sold to third parties.</p>
      </details>
      <details class="faq-item">
        <summary class="faq-q">Is the founders rate really locked?</summary>
        <p class="faq-a">Yes — as long as your subscription stays active, you keep paying the founders rate even after standard pricing rises. Cancelling and resubscribing later would be at whatever the current rate is then.</p>
      </details>
      <details class="faq-item">
        <summary class="faq-q">Do I have to be spiritual or religious to use Whisp?</summary>
        <p class="faq-a">Not at all. Whisp is belief-aware, not belief-prescriptive — you choose which frameworks (if any) the AI draws on. Plenty of people use it purely as a pattern journal.</p>
      </details>
    </div>
  </div>

  <!-- ═══ 7. RISK REVERSAL ═══ -->
  <div class="risk-reversal">
    <div class="risk-item"><span class="risk-mark">✓</span> Cancel anytime, no retention flow</div>
    <div class="risk-item"><span class="risk-mark">✓</span> Full data export on request</div>
    <div class="risk-item"><span class="risk-mark">✓</span> Permanent deletion available</div>
    <div class="risk-item"><span class="risk-mark">✓</span> Your data is never sold</div>
  </div>

  <!-- ═══ 8. FINAL CTA ═══ -->
  <div class="final-cta">
    <p class="final-cta-headline">312 spots or 3 — the offer is the same either way.<br/>The number just tells you how much longer it lasts.</p>
    <div class="counter-pill" id="counter-pill-final" data-state={initialCapReached ? 'capped' : 'open'}>
      {initialRemaining !== null ? (
        initialCapReached ? (
          <span>All 500 founding spots are taken</span>
        ) : (
          <span><strong id="counter-num-final">{initialRemaining}</strong> of {FOUNDER_CAP} founding spots remain</span>
        )
      ) : (
        <span>Founders access is limited to {FOUNDER_CAP} members</span>
      )}
    </div>
    <a href="#offer" class="btn-hero-cta">Get Founders Access ✦</a>
  </div>

  <p class="footer-mark">getwhisp.app</p>

</section>

<script>
  let selectedPlan = 'annual';

  const btnMonthly = document.getElementById('btn-monthly') as HTMLButtonElement;
  const btnAnnual  = document.getElementById('btn-annual')  as HTMLButtonElement;
  const priceEl    = document.getElementById('price-display') as HTMLSpanElement;
  const noteEl     = document.getElementById('price-note')   as HTMLSpanElement;
  const wasEl      = document.getElementById('price-was')    as HTMLSpanElement;
  const compareEl  = document.getElementById('price-compare') as HTMLParagraphElement;

  const PRICE_COPY = {
    annual:  { price: '$39.97', note: '/year · cancel anytime',  was: '$95.88/yr standard', compare: 'You save $55.91/yr — roughly 58% less than standard, locked in for as long as you stay subscribed.' },
    monthly: { price: '$3.99',  note: '/month · cancel anytime', was: '$7.99/mo standard',   compare: 'You save $4.00/mo — roughly 50% less than standard, locked in for as long as you stay subscribed.' },
  };

  function selectPlan(plan: 'annual' | 'monthly') {
    selectedPlan = plan;
    btnAnnual.classList.toggle('active', plan === 'annual');
    btnMonthly.classList.toggle('active', plan === 'monthly');
    priceEl.textContent = PRICE_COPY[plan].price;
    noteEl.textContent = PRICE_COPY[plan].note;
    wasEl.textContent = PRICE_COPY[plan].was;
    compareEl.textContent = PRICE_COPY[plan].compare;
  }

  btnAnnual.addEventListener('click', () => selectPlan('annual'));
  btnMonthly.addEventListener('click', () => selectPlan('monthly'));

  const form        = document.getElementById('checkout-form') as HTMLFormElement;
  const checkoutBtn = document.getElementById('checkout-btn')  as HTMLButtonElement;
  const btnText     = document.getElementById('btn-text')      as HTMLSpanElement;
  const btnSpin     = document.getElementById('btn-loading')   as HTMLSpanElement;
  const emailInput  = document.getElementById('email-input')   as HTMLInputElement;

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const email = emailInput.value.trim();
    if (!email) { emailInput.focus(); return; }

    checkoutBtn.disabled = true;
    btnText.style.display = 'none';
    btnSpin.style.display = 'inline';

    try {
      const res  = await fetch('/api/checkout', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email, plan: selectedPlan }),
      });
      const data = await res.json();
      if (data.url) {
        window.location.href = data.url;
      } else if (data.error === 'cap_reached') {
        alert(data.message || 'Founders access has reached its cap.');
        checkoutBtn.disabled = false;
        btnText.style.display = 'inline';
        btnSpin.style.display = 'none';
        window.location.reload(); // re-fetch so the page reflects the cap
      } else {
        throw new Error(data.error || 'Unknown error');
      }
    } catch (err: any) {
      alert('Something went wrong: ' + err.message);
      checkoutBtn.disabled = false;
      btnText.style.display = 'inline';
      btnSpin.style.display = 'none';
    }
  });

  // Re-fetch the live count on load — the server-rendered number above is
  // correct at request time, but this keeps a page left open in a tab from
  // drifting more than the 5-minute cache window.
  fetch('/api/founder-count')
    .then(r => r.json())
    .then(data => {
      if (!data.available) return; // Stripe was unreachable — leave the server-rendered value as-is
      const pills = ['hero', 'scarcity', 'final'].map(id => document.getElementById(`counter-pill-${id}`));
      const nums  = ['hero', 'scarcity', 'final'].map(id => document.getElementById(`counter-num-${id}`));
      pills.forEach((pill, i) => {
        if (!pill) return;
        if (data.capReached) {
          pill.dataset.state = 'capped';
          pill.innerHTML = '<span>All 500 founding spots are taken</span>';
        } else if (nums[i]) {
          nums[i]!.textContent = String(data.remaining);
        }
      });
    })
    .catch(() => {}); // silent — server-rendered value stays as the fallback
</script>

</MinimalLayout>

<style>
