    min-height: 100vh;
    background: linear-gradient(180deg, #07041a 0%, #0e0830 40%, #050212 100%);
    color: #faf8f3;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  /* ── Hero ──────────────────────────────────────────────────────────────── */
