  }
  .save-badge--hero {
    font-size: 10px;
  }
  .hero-price-now {
    display: flex;
    align-items: baseline;
    gap: 8px;
  }
  .hero-price-amount {
    font-family: 'Cormorant Garamond', serif;
    font-size: 44px;
    color: #F0C040;
  }
  .hero-price-note {
    font-family: 'Raleway', sans-serif;
    font-size: 13px;
    color: rgba(255,255,255,0.5);
  }

  .counter-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 16px;
    border-radius: 999px;
    background: rgba(240,192,64,0.08);
    border: 0.5px solid rgba(240,192,64,0.3);
    font-family: 'Raleway', sans-serif;
    font-size: 12.5px;
    color: rgba(255,255,255,0.75);
    margin-bottom: 24px;
  }
  .counter-pill strong { color: #F0C040; font-weight: 700; }
