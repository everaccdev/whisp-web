---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Analytics from '../components/Analytics.astro';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const {
  title = 'Whisp — A Journal for Signs & Synchronicity',
  // Was pre-positioning copy ("what the universe might be whispering")
  // predating the pattern-first rework — index.astro passes no title/
  // description/ogImage props at all, so this default IS effectively the
  // homepage's live metadata (what actually shows in search results and
  // link previews for getwhisp.app itself), not just a generic fallback.
  description = "One sign is a moment. A pattern is a message. Whisp remembers what you don't — and shows you what it adds up to.",
  // Real app screenshots (Insights, Home, Journal) in the Whispercore
  // nebula composition — was the bare app icon, which is weak for social
  // shares of the homepage itself.
  ogImage = 'https://getwhisp.app/demo-pattern.jpg',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content="https://getwhisp.app" />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#0a1020" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <title>{title}</title>
    <Analytics />
  </head>
  <body>
    <Nav />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
