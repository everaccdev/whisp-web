---
// The call to action under every share page (/s and the legacy r/c/d/je/sl/
// v/y/p pages). Two audiences:
//
// fromApp (the page was opened from inside Whisp's in-app browser, which
// adds ?from=app — computed by each page server-side and passed in, so
// nothing flashes): no store buttons, no install text, nothing that says
// "download" or "open Whisp". Instead:
//   mode 'answer' (/s pages) — "Answer it in Whisp" → whisp://answer?share={id}
//     (+ "Or log your own {symbol}" when the share carries a symbol)
//   mode 'log' (legacy pages) — "Log your own in Whisp" → whisp://log
//
// everyone else: the App Store / Google Play buttons (UTM-tagged; Google
// Play also carries an Install Referrer with the share id, which a later
// native build will read). /s pages add the "Answer it in Whisp" headline;
// legacy pages keep their own convert copy above this component.
//
// An inline script removes `from` from the address bar, so a copied link
// shows the normal page to the next person.
import { APP_STORE_URL, GOOGLE_PLAY_URL, withShareUtm } from '../lib/shareLinks';

interface Props {
  fromApp: boolean;
  shareType: string;
  id?: string;
  mode: 'answer' | 'log';
  symbol?: { name: string; type?: string | null } | null;
  accent?: string | null;
  expired?: boolean;
}

const { fromApp, shareType, id, mode, symbol = null, accent = null, expired = false } = Astro.props;

const iosUrl = withShareUtm(APP_STORE_URL, shareType, id);
const androidUrl = (() => {
  const base = withShareUtm(GOOGLE_PLAY_URL, shareType, id);
  if (!id) return base;
  try {
    const u = new URL(base);
    u.searchParams.set('referrer', `share_id=${id}`); // → referrer=share_id%3D{id}
    return u.toString();
  } catch {
    return base;
  }
})();

const answerHref = `whisp://answer?share=${encodeURIComponent(id ?? '')}`;
const logOwnHref = symbol?.name
  ? `whisp://log?symbol=${encodeURIComponent(symbol.name)}${symbol.type ? `&type=${encodeURIComponent(symbol.type)}` : ''}`
  : null;

const storeEvent = expired ? 'share_landing_expired_cta_click' : 'share_landing_cta_click';
const accentStyle = accent ? `border-color:${accent};color:${accent};` : undefined;
---

<div class="share-cta">
  {fromApp ? (
    mode === 'answer' ? (
      <>
        <a href={answerHref} class="cta-primary" data-analytics="share_landing_answer_click">Answer it in Whisp</a>
        {logOwnHref && (
          <a href={logOwnHref} class="cta-quiet" data-analytics="share_landing_log_click">Or log your own {symbol?.name}</a>
        )}
      </>
    ) : (
      <a href="whisp://log" class="cta-primary" data-analytics="share_landing_log_click">Log your own in Whisp</a>
    )
  ) : (
    <>
      {mode === 'answer' && <p class="cta-headline">Answer it in Whisp</p>}
      <div class="cta-row">
        <a href={iosUrl} class="cta-half" style={accentStyle} data-analytics={storeEvent}>App Store</a>
        <a href={androidUrl} class="cta-half" style={accentStyle} data-analytics={storeEvent}>Google Play</a>
      </div>
      <p class="microcopy">Free to start · iOS & Android</p>
    </>
  )}
</div>

<script is:inline>
  // Drop ?from=app from the address bar (only the in-app browser adds it),
  // so a link copied from here opens the normal page for the next person.
  (function () {
    try {
      var u = new URL(window.location.href);
      if (u.searchParams.has('from')) {
        u.searchParams.delete('from');
        window.history.replaceState(null, '', u.pathname + (u.search || '') + u.hash);
      }
    } catch (e) {}
  })();
</script>

<style>
  .share-cta {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
  }

  .cta-headline {
    font-family: 'Cormorant Garamond', serif;
    font-style: italic;
    font-weight: 300;
    font-size: 24px;
    color: #faf8f3;
    margin: 0 0 16px;
    line-height: 1.3;
  }

  .cta-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    max-width: 340px;
    background: #c9a84c;
    color: #0a1020;
    font-family: 'Raleway', sans-serif;
    font-weight: 700;
    font-size: 13px;
    letter-spacing: 1.5px;
    text-decoration: none;
    text-transform: uppercase;
    border-radius: 10px;
    padding: 16px 24px;
    transition: opacity 0.2s;
  }
  .cta-primary:hover { opacity: 0.85; }

  .cta-quiet {
    margin-top: 14px;
    font-family: 'Raleway', sans-serif;
    font-size: 13px;
    color: rgba(255, 255, 255, 0.55);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .cta-row {
    display: flex;
    gap: 10px;
    width: 100%;
    max-width: 340px;
  }
  .cta-half {
    flex: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: rgba(201, 168, 76, 0.1);
    border: 0.5px solid rgba(201, 168, 76, 0.45);
    color: #c9a84c;
    font-family: 'Raleway', sans-serif;
    font-weight: 700;
    font-size: 12px;
    letter-spacing: 1px;
    text-decoration: none;
    text-transform: uppercase;
    border-radius: 10px;
    padding: 14px 8px;
    transition: opacity 0.2s;
  }
  .cta-half:hover { opacity: 0.8; }

  .microcopy {
    font-family: 'Raleway', sans-serif;
    font-size: 12px;
    color: rgba(255, 255, 255, 0.28);
    margin-top: 12px;
    font-style: italic;
  }
</style>
