---
// Site-wide analytics, included in both layouts' <head>. Uses the SAME
// PostHog project the mobile app reports to (src/services/analyticsService.js
// in the main app repo) so website → app → purchase is visible in one
// timeline instead of two disconnected tools — deliberate, not an oversight.
// The key below is PostHog's public "project API key" (same trust level as
// a Stripe publishable key — meant to ship in client code), not a secret.
//
// Also captures first-touch UTM params to localStorage. PostHog itself
// already attaches utm_* as event/person properties automatically, but the
// funnel's own backend (generateLeadReading, checkout) needs them too, so
// leads and Stripe purchases carry the same attribution PostHog sees —
// see reading.astro / founders.astro, which read `whisp_utm` back out of
// localStorage when they submit.
---

<script>
  import posthog from 'posthog-js';

  posthog.init('phc_pPL9BRggMqAPts8BYnADw9X83FjxoL3QNuQbmMU6mSoJ', {
    api_host: 'https://us.i.posthog.com',
    person_profiles: 'identified_only',
  });
  (window as any).posthog = posthog; // so page-specific inline scripts can call posthog.capture(...)

  // Device-type tracking (Phase 7) — captured here, not in a page-specific
  // script, so it can't lose a race against this module's own async import
  // (a plain inline script elsewhere on the page can execute before this
  // one finishes fetching posthog-js, silently dropping an optional-chained
  // capture call). One event per pageview — the denominator for the
  // per-platform CTA click-through events.
  const ua = navigator.userAgent || '';
  const isAndroid = /Android/i.test(ua);
  const isIOS = /iPhone|iPad|iPod/i.test(ua) || (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);
  posthog.capture('website_device_detected', {
    device_type: isAndroid ? 'android' : isIOS ? 'ios' : 'desktop_or_unknown',
  });

  try {
    const params = new URLSearchParams(window.location.search);
    const utmKeys = ['utm_source', 'utm_medium', 'utm_campaign', 'utm_term', 'utm_content'];
    const hasUtm = utmKeys.some((k) => params.get(k));
    if (hasUtm && !localStorage.getItem('whisp_utm')) {
      const utm: Record<string, string> = {};
      utmKeys.forEach((k) => {
        const v = params.get(k);
        if (v) utm[k] = v;
      });
      utm.landing_page = window.location.pathname;
      utm.captured_at = new Date().toISOString();
      localStorage.setItem('whisp_utm', JSON.stringify(utm));
    }
  } catch (e) {
    // localStorage unavailable (private browsing, etc.) — attribution is
    // best-effort, never worth breaking the page over.
  }

  // Generic click tracking for any element tagged data-analytics="<event
  // name>" (Homepage Conversion Rework Phase 7). Elements across the site
  // already carry these tags (hero CTAs, nav founders link, changelog
  // teaser cards, etc.) — this single delegated listener is what actually
  // fires them, named `website_<tag>` to match the established convention
  // (see founders.astro's website_checkout_started).
  document.addEventListener('click', (e) => {
    const target = (e.target as HTMLElement)?.closest('[data-analytics]') as HTMLElement | null;
    if (!target) return;
    const name = target.getAttribute('data-analytics');
    if (!name) return;
    (window as any).posthog?.capture(`website_${name}`, {
      href: (target as HTMLAnchorElement).href || undefined,
      text: target.textContent?.trim().slice(0, 80),
    });
  });
</script>
